---
// src/components/CTA.astro
// Editorial Dark Card Callout CTA with WhatsApp Action
export interface Props {
  eyebrow?: string;
  judul?: string;
  deskripsi?: string;
  labelWa?: string;
  waUrl?: string;
}

const {
  eyebrow = 'PENGADAAN KHUSUS & KUSTOMISASI',
  judul = 'Butuh Kombinasi Paket Seminar Kit dengan Anggaran Tertentu?',
  deskripsi = 'Setiap acara memiliki tema dan skala yang berbeda. Tim konsultan seminarkit siap membantu memadukan totebag, buku agenda kulit, tumbler grafir laser, hingga hardbox kustom sesuai palet warna identitas instansi Anda.',
  labelWa = 'Diskusikan Paket Kustom',
  waUrl = '#',
} = Astro.props;
---

<section class="sk-cta-editorial-section" aria-label="Konsultasi Pengadaan Kustom">
  <div class="container">
    <div class="sk-custom-callout-card">
      <div class="row align-items-center g-4">
        <div class="col-lg-8">
          <span class="sk-callout-eyebrow">{eyebrow}</span>
          <h2 class="sk-callout-headline">
            {judul}
          </h2>
          <p class="sk-callout-desc">
            {deskripsi}
          </p>
        </div>
        <div class="col-lg-4 text-lg-end">
          <a
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="sk-callout-wa-btn"
          >
            <!-- WhatsApp SVG Logo -->
            <svg width="18" height="18" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
              <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"></path>
            </svg>
            <span>{labelWa}</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .sk-cta-editorial-section {
    background-color: #FBFAF5;
    padding: 30px 0 64px;
    position: relative;
    z-index: 2;
  }

  .sk-custom-callout-card {
    background: #1B3131;
    color: #FFFFFF;
    border-radius: 22px;
    padding: 42px 48px;
    position: relative;
    overflow: hidden;
    box-shadow: 0 12px 36px rgba(27, 49, 49, 0.16);
  }

  .sk-custom-callout-card::after {
    content: '';
    position: absolute;
    right: -30px;
    bottom: -30px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(189, 183, 107, 0.22) 0%, transparent 70%);
    pointer-events: none;
  }

  .sk-callout-eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: #BDB76B;
    margin-bottom: 8px;
  }

  .sk-callout-headline {
    font-family: var(--sk-font-serif, 'Newsreader Variable', Georgia, serif);
    font-size: clamp(1.4rem, 2.8vw, 1.85rem);
    font-weight: 600;
    line-height: 1.3;
    margin-bottom: 12px;
    color: #FFFFFF;
  }

  .sk-callout-desc {
    font-size: 0.90625rem;
    line-height: 1.65;
    color: #D3DDD9;
    margin: 0;
    max-width: 660px;
  }

  .sk-callout-wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: #BDB76B;
    color: #1B3131;
    font-weight: 700;
    font-size: 0.9375rem;
    padding: 13px 30px;
    border-radius: 50px;
    text-decoration: none;
    border: 1px solid #A8A25A;
    box-shadow: 0 4px 14px rgba(189, 183, 107, 0.35);
    transition: all 0.22s ease;
    white-space: nowrap;
    position: relative;
    z-index: 2;
  }

  .sk-callout-wa-btn:hover {
    background-color: #A8A25A;
    color: #1B3131;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(168, 162, 90, 0.45);
  }

  .sk-callout-wa-btn svg {
    flex-shrink: 0;
  }

  @media (max-width: 991.98px) {
    .sk-custom-callout-card {
      padding: 32px 28px;
    }
  }

  @media (max-width: 575.98px) {
    .sk-custom-callout-card {
      padding: 26px 20px;
    }
    .sk-callout-wa-btn {
      width: 100%;
    }
  }
</style>
