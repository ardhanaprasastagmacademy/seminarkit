---
// src/components/Footer.astro
export interface Props {
  settings?: {
    wa_number?: string;
    email?: string;
    alamat?: string;
    jam_kerja?: string;
    instagram_url?: string;
    facebook_url?: string;
    tiktok_url?: string;
  } | null;
}

const { settings } = Astro.props;
const year = new Date().getFullYear();

const cleanWa = (settings?.wa_number || '628112651789').replace(/\D/g, '');
const displayPhone = settings?.wa_number ? `+${settings.wa_number}` : '+62 811-2651-789';
---

<footer class="sk-footer-woodland" aria-label="Footer Resmi seminarkit">
  <!-- Top Woodland Forest Canopy Silhouette Cutout -->
  <div class="sk-footer-silhouette-wrap" aria-hidden="true">
    <svg class="sk-footer-silhouette-svg" viewBox="0 0 1440 85" fill="none" preserveAspectRatio="none">
      <path
        d="M0,85 L0,48 C20,46 32,32 50,32 C68,32 76,44 94,44 C112,44 122,35 138,35 C154,35 165,48 182,48 C200,48 214,26 238,26 C262,26 276,42 296,42 C312,42 324,28 344,28 C364,28 376,38 396,38 C416,38 428,20 452,20 C476,20 490,36 512,36 C528,36 540,24 560,24 C578,24 590,34 608,34 C622,34 634,22 650,22 C664,22 674,30 688,30 C700,16 718,6 742,6 C766,6 784,18 796,30 C810,30 820,22 834,22 C850,22 862,34 876,34 C894,34 906,24 924,24 C944,24 956,36 972,36 C994,36 1008,20 1032,20 C1056,20 1068,38 1088,38 C1108,38 1120,28 1140,28 C1160,28 1172,42 1188,42 C1208,42 1222,26 1246,26 C1264,26 1276,48 1294,48 C1310,48 1322,35 1338,35 C1354,35 1364,44 1382,44 C1400,44 1412,32 1430,32 C1436,32 1438,38 1440,48 L1440,85 Z"
        fill="#1B3131"
      ></path>
      <!-- Tree Canopy Details & Central Dome Hill matching Reference -->
      <circle cx="48" cy="28" r="16" fill="#1B3131"></circle>
      <circle cx="236" cy="22" r="18" fill="#1B3131"></circle>
      <circle cx="452" cy="16" r="18" fill="#1B3131"></circle>
      <!-- Center Pavilion / Dome Hill -->
      <path d="M708,34 C714,14 726,4 742,4 C758,4 770,14 776,34 Z" fill="#1B3131"></path>
      <circle cx="924" cy="20" r="16" fill="#1B3131"></circle>
      <circle cx="1032" cy="16" r="18" fill="#1B3131"></circle>
      <circle cx="1246" cy="22" r="18" fill="#1B3131"></circle>
    </svg>
  </div>

  <!-- Main Body Content (3 Columns) -->
  <div class="sk-footer-main">
    <div class="container">
      <div class="row g-4 g-lg-5 align-items-start">
        <!-- 1. Left Column: Navigation & Social -->
        <div class="col-lg-3 col-md-6 sk-footer-col sk-footer-col--left">
          <ul class="sk-footer-nav-list list-unstyled">
            <li><a href="/tentang">Tentang Kami</a></li>
            <li><a href="/produk">Katalog Produk</a></li>
            <li><a href="/galeri">Galeri Produksi</a></li>
            <li><a href="/blog">Artikel &amp; Wawasan</a></li>
            <li><a href="/kontak">Kontak Kami</a></li>
          </ul>

          <div class="sk-footer-social d-flex align-items-center gap-2 mt-4 pt-1">
            <a
              href={`https://wa.me/${cleanWa}`}
              target="_blank"
              rel="noopener noreferrer"
              class="sk-footer-social-btn"
              aria-label="WhatsApp Official"
              title="WhatsApp"
            >
              <svg width="15" height="15" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
                <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"></path>
              </svg>
            </a>
            <a
              href={settings?.instagram_url || 'https://instagram.com'}
              target="_blank"
              rel="noopener noreferrer"
              class="sk-footer-social-btn"
              aria-label="Instagram Official"
              title="Instagram"
            >
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
            </a>
            {settings?.facebook_url && (
              <a
                href={settings.facebook_url}
                target="_blank"
                rel="noopener noreferrer"
                class="sk-footer-social-btn"
                aria-label="Facebook Official"
                title="Facebook"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
              </a>
            )}
          </div>
        </div>

        <!-- 2. Middle Column: Consultation Form / Get Updates (Center) -->
        <div class="col-lg-6 col-md-12 sk-footer-col sk-footer-col--center px-lg-4 text-center">
          <h3 class="sk-footer-center-title">Dapatkan Penawaran</h3>
          <p class="sk-footer-center-sub">
            Konsultasikan kebutuhan paket seminar kit Anda atau dapatkan katalog promo terbaru langsung ke kontak Anda.
          </p>

          <form id="sk-footer-form" class="sk-footer-form mx-auto" data-wa={cleanWa}>
            <div class="mb-2">
              <input
                type="text"
                name="nama"
                id="sk-footer-nama"
                placeholder="* Nama Lengkap / Instansi"
                class="sk-footer-input"
                required
              />
            </div>
            <div class="d-flex gap-2">
              <input
                type="tel"
                name="whatsapp"
                id="sk-footer-wa"
                placeholder="* Nomor WhatsApp"
                class="sk-footer-input flex-grow-1"
                required
              />
              <button type="submit" class="sk-footer-submit-btn">
                KIRIM
              </button>
            </div>
          </form>
        </div>

        <!-- 3. Right Column: Contact & Location (Right) -->
        <div class="col-lg-3 col-md-6 sk-footer-col sk-footer-col--right text-lg-end">
          <a href="/kontak" class="sk-footer-arrow-link d-inline-flex align-items-center gap-2">
            <span>Kirim Pesan</span>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
          </a>

          <div class="sk-footer-phone mt-3">
            <a href={`https://wa.me/${cleanWa}`} target="_blank" rel="noopener noreferrer">
              {displayPhone}
            </a>
          </div>

          <p class="sk-footer-address mt-2 ms-lg-auto">
            {settings?.alamat || 'Jl. Kaliurang Km 12.5, Sleman, D.I. Yogyakarta 55581'}
          </p>

          <div class="sk-footer-hours mt-1">
            {settings?.jam_kerja || 'Senin–Jumat: 08.00–17.00 WIB'}
          </div>

          <!-- Official Emblem Seal Stamp -->
          <div class="sk-footer-emblem-wrap mt-3 d-inline-block">
            <svg class="sk-footer-emblem" width="136" height="44" viewBox="0 0 160 52" fill="none" aria-label="Seminarkit Official Seal">
              <ellipse cx="80" cy="26" rx="76" ry="23" stroke="#D3DDD8" stroke-width="1.3" stroke-dasharray="4 2"></ellipse>
              <ellipse cx="80" cy="26" rx="71" ry="19" stroke="#D3DDD8" stroke-width="0.9"></ellipse>
              <text x="80" y="24" text-anchor="middle" font-family="serif" font-weight="700" font-size="10" fill="#E8ECE9" letter-spacing="2">SEMINARKIT</text>
              <text x="80" y="36" text-anchor="middle" font-family="sans-serif" font-weight="600" font-size="7.5" fill="#BCCEC7" letter-spacing="1.2">QUALITY &bull; TRUSTED</text>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Sub-Footer Bottom Copyright Bar -->
  <div class="sk-footer-bottom">
    <div class="container d-flex flex-wrap justify-content-between align-items-center gap-2">
      <div class="sk-footer-copy">
        &copy; {year} seminarkit. Semua Hak Dilindungi.
      </div>
      <div class="sk-footer-bottom-links d-flex align-items-center gap-4">
        <a href="/kebijakan-privasi">Kebijakan Privasi</a>
        <a href="/faq">FAQ</a>
        <a href="/kontak">Bantuan</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .sk-footer-woodland {
    background: #1B3131;
    color: #D6E1DD;
    position: relative;
    margin-top: 50px;
  }

  .sk-footer-silhouette-wrap {
    position: relative;
    width: 100%;
    line-height: 0;
    overflow: hidden;
    background-color: transparent;
    margin-top: -50px;
    pointer-events: none;
  }

  .sk-footer-silhouette-svg {
    display: block;
    width: 100%;
    height: clamp(48px, 6vw, 76px);
    transform: translateY(2px);
  }

  .sk-footer-main {
    padding: 38px 0 54px;
    background: #1B3131;
  }

  /* Left Column */
  .sk-footer-nav-list li {
    margin-bottom: 9px;
  }

  .sk-footer-nav-list a {
    color: #FFFFFF;
    font-size: 0.95rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
    display: inline-block;
  }

  .sk-footer-nav-list a:hover {
    color: #BDB76B;
    transform: translateX(3px);
  }

  .sk-footer-social-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    color: #FFFFFF;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.22s ease;
  }

  .sk-footer-social-btn:hover {
    background: #BDB76B;
    border-color: #BDB76B;
    color: #1B3131;
    transform: translateY(-2px);
  }

  /* Center Column with Vertical Dividers on Desktop */
  @media (min-width: 992px) {
    .sk-footer-col--center {
      border-left: 1px solid rgba(255, 255, 255, 0.12);
      border-right: 1px solid rgba(255, 255, 255, 0.12);
    }
  }

  .sk-footer-center-title {
    font-family: var(--sk-font-serif);
    font-size: clamp(1.45rem, 2.4vw, 1.85rem);
    font-weight: 700;
    color: #FFFFFF;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }

  .sk-footer-center-sub {
    font-family: var(--sk-font-serif);
    font-style: italic;
    font-size: 0.925rem;
    color: #D6E1DD;
    line-height: 1.55;
    max-width: 440px;
    margin: 0 auto 20px;
  }

  .sk-footer-form {
    max-width: 420px;
  }

  .sk-footer-input {
    width: 100%;
    background: rgba(0, 0, 0, 0.22);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 6px;
    color: #FFFFFF;
    padding: 10px 14px;
    font-size: 0.875rem;
    transition: border-color 0.2s ease, background 0.2s ease;
  }

  .sk-footer-input::placeholder {
    color: rgba(255, 255, 255, 0.6);
  }

  .sk-footer-input:focus {
    outline: none;
    border-color: #BDB76B;
    background: rgba(0, 0, 0, 0.35);
  }

  .sk-footer-submit-btn {
    background: #FAF6ED;
    color: #1B3131;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    padding: 10px 22px;
    border-radius: 6px;
    border: none;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .sk-footer-submit-btn:hover {
    background: #BDB76B;
    color: #1B3131;
    transform: translateY(-1px);
  }

  /* Right Column */
  .sk-footer-arrow-link {
    color: #FFFFFF;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .sk-footer-arrow-link:hover {
    color: #BDB76B;
  }

  .sk-footer-phone a {
    color: #FFFFFF;
    font-size: 1.15rem;
    font-weight: 700;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.2s ease;
  }

  .sk-footer-phone a:hover {
    color: #BDB76B;
  }

  .sk-footer-address {
    font-size: 0.875rem;
    color: #D6E1DD;
    line-height: 1.55;
    max-width: 280px;
  }

  .sk-footer-hours {
    font-size: 0.8125rem;
    color: #9DB0AA;
  }

  .sk-footer-emblem {
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .sk-footer-emblem:hover {
    opacity: 1;
  }

  /* Sub-footer Bottom Bar */
  .sk-footer-bottom {
    background: #142525;
    padding: 18px 0;
    font-size: 0.8125rem;
    color: #9DB0AA;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sk-footer-bottom-links a {
    color: #9DB0AA;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .sk-footer-bottom-links a:hover {
    color: #FFFFFF;
  }

  @media (max-width: 991px) {
    .sk-footer-col--center {
      padding-top: 28px;
      padding-bottom: 28px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .sk-footer-col--right {
      text-align: left !important;
    }
    .sk-footer-address {
      margin-left: 0 !important;
    }
  }
</style>

<script>
  function initFooterForm() {
    const form = document.getElementById('sk-footer-form') as HTMLFormElement | null;
    if (!form || (form as any)._initialized) return;
    (form as any)._initialized = true;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const namaInput = document.getElementById('sk-footer-nama') as HTMLInputElement | null;
      const waInput = document.getElementById('sk-footer-wa') as HTMLInputElement | null;
      const nama = namaInput?.value.trim() || '';
      const wa = waInput?.value.trim() || '';
      const waTarget = form.dataset.wa || '628112651789';

      const msg = `Halo seminarkit, saya *${nama}* (${wa}) ingin berkonsultasi mengenai kebutuhan paket seminar kit dan meminta katalog penawaran terbaru.`;
      const url = `https://wa.me/${waTarget}?text=${encodeURIComponent(msg)}`;
      window.open(url, '_blank', 'noopener,noreferrer');
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFooterForm);
  } else {
    initFooterForm();
  }
  document.addEventListener('astro:page-load', initFooterForm);
</script>
