---
// src/components/SeoHead.astro
export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: object | object[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd,
} = Astro.props;

const siteUrl = import.meta.env.PUBLIC_SITE_URL ?? 'https://seminarkit.id';
const canonicalUrl = canonical ?? siteUrl + Astro.url.pathname;
const ogImg = ogImage ?? siteUrl + '/og-default.jpg';

const safeJson = (obj: unknown) => JSON.stringify(obj).replace(/</g, '\\u003c');

const schemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title} — seminarkit</title>
<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={`${title} — seminarkit`} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImg} />
<meta property="og:locale" content="id_ID" />
<meta property="og:site_name" content="seminarkit" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={`${title} — seminarkit`} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImg} />

<!-- Favicon -->
<link rel="icon" type="image/webp" href="/images/favicon.webp" />
<link rel="shortcut icon" href="/images/favicon.webp" />
<link rel="apple-touch-icon" href="/images/favicon.webp" />

<!-- JSON-LD -->
{schemas.map(schema => (
  <script type="application/ld+json" set:html={safeJson(schema)} />
))}
