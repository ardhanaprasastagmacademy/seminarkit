---
// src/components/ProductCard.astro
// Clean, Refined & Spacious Artisan Product Card
import { formatRupiah } from '../lib/format';
import { buildWaFromProduct } from '../lib/wa';

export interface Props {
  product: {
    id: string;
    nama: string;
    slug: string;
    deskripsi_singkat: string;
    harga_mulai: number;
    satuan: string;
    gambar_url?: string | null;
    gambar_alt?: string | null;
    min_order?: number | null;
    is_featured?: boolean | null;
    category_id?: string | null;
    kategori?: { nama: string; slug: string } | null;
  };
  categoryName?: string | null;
  waNumber?: string | null;
}

const { product, categoryName, waNumber } = Astro.props;
const waUrl = buildWaFromProduct(waNumber, product.nama);
const imgSrc = product.gambar_url || '/images/placeholder-product.svg';
const imgAlt = product.gambar_alt || product.nama;
const detailUrl = `/produk/${product.slug}`;

// Resolusi kategori tampil
const displayCategory = categoryName || product.kategori?.nama || null;
---

<article
  class="sk-product-card"
  data-product-title={product.nama.toLowerCase()}
  data-product-price={product.harga_mulai}
  data-product-desc={(product.deskripsi_singkat || '').toLowerCase()}
>
  <!-- Card Image Frame -->
  <div class="sk-product-media-wrap">
    <a href={detailUrl} class="sk-product-media-link" aria-label={`Lihat detail ${product.nama}`}>
      <img
        src={imgSrc}
        alt={imgAlt}
        width="600"
        height="450"
        loading="lazy"
        decoding="async"
        class="sk-product-img"
        onerror="this.src='/images/hero-seminar-kit.webp';"
      />
    </a>
  </div>

  <!-- Card Body -->
  <div class="sk-product-body">
    <!-- Category Eyebrow -->
    {displayCategory && (
      <div class="sk-product-category-eyebrow">
        {displayCategory}
      </div>
    )}

    <!-- Title -->
    <h3 class="sk-product-title">
      <a href={detailUrl}>
        {product.nama}
      </a>
    </h3>

    <!-- Description (Clean 2-line clamp) -->
    <p class="sk-product-desc">
      {product.deskripsi_singkat}
    </p>

    <!-- Bottom Section: Price & Actions (Pushed to bottom) -->
    <div class="sk-product-bottom-block">
      <!-- Price Row -->
      <div class="sk-product-price-section">
        <span class="sk-price-label">Mulai dari</span>
        <div class="sk-price-amount-wrap">
          <span class="sk-price-amount">{formatRupiah(product.harga_mulai)}</span>
          <span class="sk-price-unit">/{product.satuan}</span>
        </div>
      </div>

      <!-- Action Buttons Row (Balanced 50/50 side-by-side) -->
      <div class="sk-product-actions-grid">
        <a href={detailUrl} class="sk-btn-detail">
          Detail
        </a>
        <a
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="sk-btn-wa"
        >
          <svg width="14" height="14" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"></path>
          </svg>
          <span>Pesan WA</span>
        </a>
      </div>
    </div>
  </div>
</article>

<style>
  /* ========================================================
     CLEAN & SPACIOUS PRODUCT CARD (NO CLUTTER, BALANCED)
     ======================================================== */
  .sk-product-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #FFFFFF;
    border: 1px solid rgba(27, 49, 49, 0.1);
    border-radius: 16px;
    overflow: hidden;
    position: relative;
    box-shadow: 0 3px 12px rgba(27, 49, 49, 0.03);
    transition: transform 0.28s cubic-bezier(0.2, 0.8, 0.2, 1),
                box-shadow 0.28s ease,
                border-color 0.24s ease;
  }

  .sk-product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(27, 49, 49, 0.09);
    border-color: rgba(139, 147, 100, 0.45);
  }

  /* Image Frame */
  .sk-product-media-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: #EDEAE1;
  }

  .sk-product-media-link {
    display: block;
    width: 100%;
    height: 100%;
    outline: none;
  }

  .sk-product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .sk-product-card:hover .sk-product-img {
    transform: scale(1.035);
  }

  /* Body Content */
  .sk-product-body {
    display: flex;
    flex-direction: column;
    padding: 22px 22px 20px;
    flex: 1;
  }

  /* Category Eyebrow Text */
  .sk-product-category-eyebrow {
    font-size: 0.71875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: #8B9364;
    margin-bottom: 6px;
    line-height: 1.2;
  }

  /* Title */
  .sk-product-title {
    font-family: var(--sk-font-serif, 'Newsreader Variable', Georgia, serif);
    font-size: 1.28rem;
    font-weight: 600;
    line-height: 1.35;
    margin: 0 0 10px;
    letter-spacing: -0.01em;
  }

  .sk-product-title a {
    color: #1B3131;
    text-decoration: none !important;
    outline: none;
    transition: color 0.2s ease, font-weight 0.15s ease;
  }

  .sk-product-title a:hover,
  .sk-product-card:hover .sk-product-title a {
    color: #0F1F1F;
    font-weight: 800;
    text-decoration: none !important;
    outline: none;
  }

  /* Description */
  .sk-product-desc {
    color: #556660;
    font-size: 0.85rem;
    line-height: 1.55;
    margin: 0 0 20px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Bottom Block */
  .sk-product-bottom-block {
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid #ECE7DB;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  /* Price Section */
  .sk-product-price-section {
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .sk-price-label {
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: #8B9364;
    line-height: 1.2;
  }

  .sk-price-amount-wrap {
    display: flex;
    align-items: baseline;
    gap: 4px;
  }

  .sk-price-amount {
    font-family: var(--sk-font-serif, 'Newsreader Variable', Georgia, serif);
    font-size: 1.375rem;
    font-weight: 700;
    color: #1B3131;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .sk-price-unit {
    font-size: 0.8125rem;
    color: #6A7B75;
    font-weight: 500;
  }

  /* Action Buttons Grid (50/50 Balanced) */
  .sk-product-actions-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    width: 100%;
  }

  .sk-btn-detail {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 14px;
    border-radius: 50px;
    font-size: 0.84375rem;
    font-weight: 600;
    color: #1B3131;
    background: #FFFFFF;
    border: 1px solid rgba(27, 49, 49, 0.2);
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .sk-btn-detail:hover {
    background: #F4EFE6;
    border-color: #8B9364;
    color: #1B3131;
  }

  .sk-btn-wa {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 40px;
    padding: 0 14px;
    border-radius: 50px;
    font-size: 0.84375rem;
    font-weight: 700;
    color: #1B3131;
    background: #BDB76B;
    border: 1px solid #A8A25A;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 2px 6px rgba(189, 183, 107, 0.22);
  }

  .sk-btn-wa:hover {
    background: #A8A25A;
    color: #1B3131;
    box-shadow: 0 4px 10px rgba(168, 162, 90, 0.35);
    transform: translateY(-1px);
  }

  @media (max-width: 480px) {
    .sk-product-body {
      padding: 18px 18px 16px;
    }
  }
</style>
