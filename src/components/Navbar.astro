---
// src/components/Navbar.astro
import { nav } from '../data/site';
import { buildWaFromPage } from '../lib/wa';

export interface Props {
  waNumber?: string | null;
  currentPage?: string;
}

const { waNumber, currentPage = 'Beranda' } = Astro.props;
const waUrl = buildWaFromPage(waNumber, currentPage);

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  href === '/' ? path === '/' : path === href || path.startsWith(href + '/');

const isBlogDetail = Astro.url.pathname.startsWith('/blog/') && Astro.url.pathname !== '/blog';
---
<a href="#main-content" class="skip-link">Lompat ke konten utama</a>

<!-- Sentinel 16px at the very top of document for ultra-fast, bulletproof IntersectionObserver scroll detection -->
<div id="sk-nav-sentinel" style="position: absolute; top: 0; left: 0; width: 100%; height: 16px; pointer-events: none; opacity: 0; z-index: -1;" aria-hidden="true"></div>

<nav class:list={[
  'navbar navbar-expand-lg sk-navbar fixed-top',
  isBlogDetail && 'sk-navbar--solid-always is-scrolled'
]} data-bs-theme="dark" aria-label="Navigasi utama">
  <div class="container">
    
    <!-- Brand Logo: seminarkit Logo Image -->
    <a class="navbar-brand" href="/" aria-label="Beranda seminarkit">
      <img
        src="/images/logo.png"
        alt="seminarkit"
        class="sk-navbar-logo"
        width="155"
        height="52"
        loading="eager"
        fetchpriority="high"
      />
    </a>

    <!-- Hamburger Toggler for Mobile (triggers offcanvas sidebar from left) -->
    <button
      class="navbar-toggler border-0 shadow-none"
      type="button"
      id="sk-nav-toggler"
      aria-controls="nav-offcanvas"
      aria-label="Buka menu navigasi"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Navigation Drawer: Offcanvas on mobile (slides from left to right), inline on desktop -->
    <div
      class="offcanvas offcanvas-start sk-nav-offcanvas"
      tabindex="-1"
      id="nav-offcanvas"
      aria-labelledby="nav-offcanvas-label"
      data-bs-theme="dark"
    >
      <!-- Offcanvas Header with Brand Logo & Close Button (Mobile only) -->
      <div class="offcanvas-header d-lg-none">
        <a class="navbar-brand m-0" href="/" aria-label="Beranda seminarkit">
          <img
            src="/images/logo.png"
            alt="seminarkit"
            class="sk-navbar-logo"
            width="135"
            height="45"
            style="height: 38px; width: auto;"
          />
        </a>
        <button
          type="button"
          class="btn-close btn-close-white shadow-none"
          id="sk-nav-close"
          aria-label="Tutup navigasi"
        ></button>
      </div>

      <!-- Offcanvas Body -->
      <div class="offcanvas-body">
        <ul class="navbar-nav mx-auto align-items-lg-center gap-lg-1 my-2 my-lg-0">
          <li class="nav-item">
            <a class="nav-link" href="/" aria-current={isActive('/') ? 'page' : undefined}>Beranda</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/tentang" aria-current={isActive('/tentang') ? 'page' : undefined}>Tentang</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/produk" aria-current={isActive('/produk') ? 'page' : undefined}>Produk</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/galeri" aria-current={isActive('/galeri') ? 'page' : undefined}>Galeri</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/blog" aria-current={isActive('/blog') ? 'page' : undefined}>Blog</a>
          </li>
          <li class="nav-item">
            <a class="nav-link" href="/kontak" aria-current={isActive('/kontak') ? 'page' : undefined}>Kontak</a>
          </li>
        </ul>

        <!-- Mobile Drawer CTA Button -->
        <div class="sk-offcanvas-cta-wrap ms-lg-3">
          <a
            class="sk-nav-cta-btn"
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
          >Pesan Sekarang</a>
        </div>
      </div>
    </div>

  </div>
</nav>

<!-- Backdrop overlay for mobile drawer -->
<div id="sk-nav-backdrop" class="sk-nav-backdrop d-lg-none" aria-hidden="true"></div>

<script is:inline>
  (function() {
    const navbar = document.querySelector('.sk-navbar');
    if (!navbar) return;

    // 1. Mobile Offcanvas Navigation Toggle (Active on all pages)
    const toggler = document.getElementById('sk-nav-toggler') || document.querySelector('.navbar-toggler');
    const offcanvasEl = document.getElementById('nav-offcanvas');
    const closeBtn = document.getElementById('sk-nav-close') || (offcanvasEl ? offcanvasEl.querySelector('.btn-close') : null);
    const backdrop = document.getElementById('sk-nav-backdrop');

    if (toggler && offcanvasEl) {
      function openDrawer(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        offcanvasEl.classList.add('show', 'is-open');
        offcanvasEl.style.visibility = 'visible';
        offcanvasEl.style.transform = 'translateX(0)';
        document.body.style.overflow = 'hidden';
        if (backdrop) {
          backdrop.classList.add('show');
        }
      }

      function closeDrawer(e) {
        if (e) {
          e.preventDefault();
          e.stopPropagation();
        }
        offcanvasEl.classList.remove('show', 'is-open');
        offcanvasEl.style.transform = '';
        offcanvasEl.style.visibility = '';
        document.body.style.overflow = '';
        if (backdrop) {
          backdrop.classList.remove('show');
        }
      }

      toggler.addEventListener('click', openDrawer);

      if (closeBtn) {
        closeBtn.addEventListener('click', closeDrawer);
      }

      if (backdrop) {
        backdrop.addEventListener('click', closeDrawer);
      }

      // Close when clicking any nav link
      offcanvasEl.querySelectorAll('.nav-link, .sk-nav-cta-btn').forEach(function(link) {
        link.addEventListener('click', function() {
          closeDrawer();
        });
      });

      // Close on Escape key
      window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeDrawer();
      });
    }

    // If page is marked permanently solid on server (e.g. editorial blog detail), skip dynamic transparency
    if (navbar.classList.contains('sk-navbar--solid-always')) {
      return;
    }

    // 2. Dynamic Scroll Transparency Controller
    const sentinel = document.getElementById('sk-nav-sentinel');

    function applyScrolled(isScrolled) {
      if (isScrolled) {
        navbar.classList.add('is-scrolled');
        navbar.style.setProperty('background', '#142822', 'important');
        navbar.style.setProperty('background-color', '#142822', 'important');
        navbar.style.setProperty('box-shadow', '0 4px 24px rgba(0, 0, 0, 0.45)', 'important');
        navbar.style.setProperty('border-bottom', '1px solid rgba(255, 255, 255, 0.08)', 'important');
      } else {
        navbar.classList.remove('is-scrolled');
        navbar.style.setProperty('background', 'transparent', 'important');
        navbar.style.setProperty('background-color', 'transparent', 'important');
        navbar.style.setProperty('box-shadow', 'none', 'important');
        navbar.style.setProperty('border-bottom', '1px solid transparent', 'important');
      }
    }

    // IntersectionObserver (Hardware accelerated)
    if ('IntersectionObserver' in window && sentinel) {
      const observer = new IntersectionObserver(function(entries) {
        const entry = entries[0];
        applyScrolled(!entry.isIntersecting);
      }, { rootMargin: '0px', threshold: 0 });
      observer.observe(sentinel);
    }

    // Scroll & Touchmove event listeners
    function checkScroll() {
      const top = window.pageYOffset || document.documentElement.scrollTop || window.scrollY || 0;
      applyScrolled(top > 12);
    }

    window.addEventListener('scroll', checkScroll, { passive: true });
    document.addEventListener('scroll', checkScroll, { passive: true });
    window.addEventListener('wheel', checkScroll, { passive: true });
    window.addEventListener('touchmove', checkScroll, { passive: true });
    window.addEventListener('resize', checkScroll, { passive: true });
    checkScroll();
  })();
</script>
