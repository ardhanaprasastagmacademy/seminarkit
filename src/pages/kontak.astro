<!-- Turnstile script -->
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script>
  (() => {
    const form = document.getElementById('inquiry-form') as HTMLFormElement;
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
    const notice = document.getElementById('form-notice') as HTMLElement;
    const waFallback = document.getElementById('wa-fallback') as HTMLElement;
    const waFallbackLink = document.getElementById('wa-fallback-link') as HTMLAnchorElement;
    const tInput = document.getElementById('form-t') as HTMLInputElement;

    // Set time trap
    if (tInput) tInput.value = String(Date.now());

    function showError(id: string, msg: string) {
      const el = document.getElementById(id);
      if (!el) return;
      el.textContent = msg;
      el.style.display = 'block';
      const input = document.getElementById(id.replace('err-', ''));
      input?.classList.add('is-invalid');
    }

    function clearErrors() {
      document.querySelectorAll('.sk-error').forEach(el => {
        (el as HTMLElement).style.display = 'none';
      });
      document.querySelectorAll('.is-invalid').forEach(el => el.classList.remove('is-invalid'));
    }

    function validate(data: Record<string, string>): boolean {
      let ok = true;
      if (!data.nama || data.nama.trim().length < 2) {
        showError('err-nama', 'Nama minimal 2 karakter.'); ok = false;
      }
      if (!data.noWa || data.noWa.trim().length < 8) {
        showError('err-noWa', 'Nomor WhatsApp tidak valid.'); ok = false;
      }
      if (data.email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(data.email)) {
        showError('err-email', 'Format email tidak valid.'); ok = false;
      }
      const jumlah = parseInt(data.jumlah ?? '', 10);
      if (data.jumlah && (isNaN(jumlah) || jumlah < 1)) {
        showError('err-jumlah', 'Jumlah tidak valid.'); ok = false;
      }
      const consent = (document.getElementById('consent') as HTMLInputElement)?.checked;
      if (!consent) {
        showError('err-consent', 'Anda perlu menyetujui penggunaan data sebelum melanjutkan.'); ok = false;
      }
      return ok;
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();

      const fd = new FormData(form);
      const data: Record<string, string> = {};
      fd.forEach((val, key) => { data[key] = String(val); });

      // Ambil Turnstile token
      const token = (window as any).turnstile?.getResponse('#turnstile-widget') ?? '';
      data.turnstileToken = token;
      data.sourcePage = window.location.pathname;

      if (!validate(data)) return;

      submitBtn.textContent = 'Mengirim…';
      submitBtn.setAttribute('aria-disabled', 'true');
      submitBtn.disabled = true;

      try {
        const res = await fetch('/api/inquiry', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));

        if (!res.ok && res.status !== 200) {
          if (json.errors) {
            Object.entries(json.errors).forEach(([field, msg]) => {
              showError('err-' + field, String(msg));
            });
            notice.className = 'sk-notice sk-notice--error mb-4';
            notice.textContent = json.message || 'Mohon lengkapi kolom yang bertanda merah.';
            notice.style.display = 'block';
          } else if (json.error === 'captcha') {
            showError('err-captcha', 'Verifikasi keamanan gagal. Silakan muat ulang dan coba lagi.');
            notice.className = 'sk-notice sk-notice--error mb-4';
            notice.textContent = 'Verifikasi keamanan diperlukan.';
            notice.style.display = 'block';
          } else {
            notice.className = 'sk-notice sk-notice--error mb-4';
            notice.textContent = json.message || 'Terjadi kesalahan saat memproses formulir. Silakan coba lagi.';
            notice.style.display = 'block';
          }
          return;
        }

        // Sukses
        notice.className = 'sk-notice sk-notice--success mb-4';
        notice.innerHTML = json.saved
          ? '<strong>Permintaan Terkirim!</strong> Data Anda telah kami terima dan kami sedang menyiapkan penawaran resmi. Anda akan dialihkan ke WhatsApp resmi kami…'
          : 'Pesan konsultasi Anda telah siap. Klik tombol di bawah untuk membuka WhatsApp:';
        notice.style.display = 'block';

        if (json.waUrl) {
          waFallback.style.display = 'block';
          waFallbackLink.href = json.waUrl;
          setTimeout(() => { location.assign(json.waUrl); }, 1200);
        }
      } catch {
        notice.className = 'sk-notice sk-notice--error mb-4';
        notice.textContent = 'Terjadi gangguan koneksi internet. Silakan periksa koneksi Anda dan coba lagi.';
        notice.style.display = 'block';
      } finally {
        submitBtn.textContent = 'Kirim Formulir via WhatsApp';
        submitBtn.removeAttribute('aria-disabled');
        submitBtn.disabled = false;
        (window as any).turnstile?.reset('#turnstile-widget');
      }
    });

    // Custom Dropdown Controller (Mobile responsive & no overflow)
    const wrap = document.getElementById('custom-produk-dropdown');
    const trigger = document.getElementById('custom-produk-trigger');
    const label = document.getElementById('custom-produk-label');
    const menu = document.getElementById('custom-produk-menu');
    const nativeSelect = document.getElementById('produk') as HTMLSelectElement;

    if (wrap && trigger && label && menu && nativeSelect) {
      function openDropdown() {
        wrap.classList.add('is-open');
        menu.style.display = 'block';
        trigger.setAttribute('aria-expanded', 'true');
      }

      function closeDropdown() {
        wrap.classList.remove('is-open');
        menu.style.display = 'none';
        trigger.setAttribute('aria-expanded', 'false');
      }

      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        if (menu.style.display === 'block') {
          closeDropdown();
        } else {
          openDropdown();
        }
      });

      menu.querySelectorAll<HTMLElement>('.sk-custom-select-item').forEach(item => {
        item.addEventListener('click', () => {
          const val = item.getAttribute('data-val') || '';
          nativeSelect.value = val;

          // Update trigger label
          label.textContent = item.textContent?.trim() || 'Pilih paket / produk (opsional)';
          if (val) {
            wrap.classList.add('has-selection');
          } else {
            wrap.classList.remove('has-selection');
          }

          // Update active item states
          menu.querySelectorAll('.sk-custom-select-item').forEach(i => {
            i.classList.remove('is-selected');
            i.setAttribute('aria-selected', 'false');
          });
          item.classList.add('is-selected');
          item.setAttribute('aria-selected', 'true');

          closeDropdown();
        });
      });

      document.addEventListener('click', (e) => {
        if (!wrap.contains(e.target as Node)) {
          closeDropdown();
        }
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeDropdown();
      });
    }
  })();
</script>
