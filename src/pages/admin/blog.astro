    /* ---------- Accordion: Advanced Settings ---------- */
    .sk-advanced-details {
      border: 1px solid #E2E8F0;
      border-radius: 10px;
      overflow: hidden;
      background: #FFFFFF;
    }

    .sk-advanced-summary {
      background: #F8FAFC;
      padding: 10px 16px;
      font-size: 0.8125rem;
      color: #334155;
