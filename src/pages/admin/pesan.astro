---
// src/pages/admin/pesan.astro
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Pesan Masuk" activePage="pesan">
  <!-- Top Action & Filter Row -->
  <div class="sk-modern-card mb-3 p-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
      <!-- Date Filter Pills -->
      <div class="d-flex flex-wrap align-items-center gap-2" id="filter-bar">
        <span style="font-size:.75rem;font-weight:700;color:var(--sk-admin-text-muted);text-transform:uppercase;letter-spacing:.05em;margin-right:4px;">Filter:</span>
        <button type="button" class="sk-filter-pill active" data-filter="semua">Semua</button>
        <button type="button" class="sk-filter-pill" data-filter="hari_ini">Hari Ini</button>
        <button type="button" class="sk-filter-pill" data-filter="kemarin">Kemarin</button>
        <button type="button" class="sk-filter-pill" data-filter="1_minggu">1 Minggu yang Lalu</button>
      </div>

      <!-- Search & CSV Action -->
      <div class="d-flex align-items-center gap-2 ms-auto">
        <div class="sk-search-pill" style="width:240px;">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            type="search"
            id="pesan-search"
            placeholder="Cari pengirim / no WA…"
            style="padding-top:8px;padding-bottom:8px;font-size:.8125rem;"
          />
        </div>
        <button type="button" id="export-csv" class="sk-pill-btn sk-pill-btn--outline" style="padding:8px 18px;font-size:.8125rem;white-space:nowrap;">
          Ekspor CSV
        </button>
      </div>
    </div>
  </div>

  <!-- Messages Table Card -->
  <div class="sk-modern-card">
    <div class="sk-card-header-row">
      <h2 class="sk-card-title">Daftar Permintaan Penawaran</h2>
      <span id="pesan-count" style="font-size:.8125rem;color:var(--sk-admin-text-muted);">Memuat data…</span>
    </div>

    <div class="sk-modern-table-wrap">
      <table class="sk-modern-table" id="pesan-table">
        <thead>
          <tr>
            <th style="width:140px;">Waktu</th>
            <th>Pengirim & Instansi</th>
            <th>Kontak WhatsApp</th>
            <th>Produk Diminati</th>
            <th>Jumlah</th>
            <th style="width:160px;">Status</th>
            <th style="width:120px;">Tindakan</th>
          </tr>
        </thead>
        <tbody id="pesan-tbody">
          <tr>
            <td colspan="7" class="text-center py-5" style="color:var(--sk-admin-text-muted);">
              Memuat data pesan masuk…
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Template Pesan WhatsApp Klien -->
  <div class="modal fade" id="waModal" tabindex="-1" aria-label="Template Pesan WhatsApp" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
      <div class="modal-content" style="border-radius:18px;border:1px solid var(--sk-admin-card-border);box-shadow:0 20px 45px rgba(0,0,0,0.15);overflow:hidden;">
        <div class="modal-header" style="background:var(--sk-admin-surface-subtle);border-bottom:1px solid var(--sk-admin-card-border);padding:18px 24px;">
          <div>
            <h2 class="modal-title h5 font-weight-bold mb-1" style="color:var(--sk-admin-primary);font-size:1.05rem;">
              Hubungi Klien via WhatsApp
            </h2>
            <p class="mb-0 text-muted" id="wa-modal-sub" style="font-size:0.8125rem;">
              Memuat data klien…
            </p>
          </div>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>

        <div class="modal-body p-4">
          <!-- Template Selection Pills -->
          <div class="mb-3">
            <label class="d-block mb-2" style="font-size:0.75rem;font-weight:700;color:var(--sk-admin-text-muted);text-transform:uppercase;letter-spacing:0.05em;">
              Pilih Template Sesuai Status:
            </label>
            <div class="d-flex flex-wrap gap-2" id="wa-template-tabs">
              <button
                type="button"
                class="sk-filter-pill"
                data-status="terkonfirmasi"
                style="border-radius:50px;padding:6px 16px;font-size:0.8125rem;"
              >
                ✓ Terkonfirmasi
              </button>
              <button
                type="button"
                class="sk-filter-pill"
                data-status="baru"
                style="border-radius:50px;padding:6px 16px;font-size:0.8125rem;"
              >
                ⏳ Permintaan Baru / Follow Up
              </button>
              <button
                type="button"
                class="sk-filter-pill"
                data-status="batal"
                style="border-radius:50px;padding:6px 16px;font-size:0.8125rem;"
              >
                ✕ Dibatalkan
              </button>
            </div>
          </div>

          <!-- Message Textarea with Live Preview -->
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-1.5">
              <label for="wa-message-text" style="font-size:0.75rem;font-weight:700;color:var(--sk-admin-text-muted);text-transform:uppercase;letter-spacing:0.05em;">
                Isi Pesan WhatsApp (Dapat Diedit Sebelum Dikirim):
              </label>
              <span id="wa-copy-badge" style="font-size:0.75rem;color:#16A34A;display:none;font-weight:600;">✓ Teks Berhasil Disalin!</span>
            </div>
            <textarea
              id="wa-message-text"
              class="form-control sk-input"
              rows="9"
              style="font-size:0.84rem;line-height:1.6;border-radius:12px;padding:12px 14px;background:#fff;"
              placeholder="Tulis atau edit pesan WhatsApp…"
            ></textarea>
          </div>

          <!-- Inquiry Context Summary Box -->
          <div class="p-3" style="background:var(--sk-admin-surface-subtle);border-radius:12px;border:1px solid var(--sk-admin-card-border);font-size:0.8125rem;">
            <div class="d-flex flex-wrap gap-3" id="wa-modal-meta">
              <!-- Rendered dynamically -->
            </div>
          </div>
        </div>

        <div class="modal-footer" style="background:var(--sk-admin-surface-subtle);border-top:1px solid var(--sk-admin-card-border);padding:14px 24px;">
          <button type="button" class="sk-pill-btn sk-pill-btn--outline" id="btn-copy-wa" style="padding:8px 18px;font-size:0.8125rem;">
            📋 Salin Pesan
          </button>
          <button type="button" class="sk-pill-btn sk-pill-btn--outline" data-bs-dismiss="modal" style="padding:8px 18px;font-size:0.8125rem;">
            Tutup
          </button>
          <a
            id="btn-send-wa"
            href="#"
            target="_blank"
            rel="noopener noreferrer"
            class="sk-pill-btn sk-pill-btn--primary"
            style="padding:8px 22px;font-size:0.8125rem;background:#1B3131;color:#fff;display:inline-flex;align-items:center;gap:6px;text-decoration:none;"
          >
            <span>Buka WhatsApp</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { getSupabaseBrowser } from '../../lib/supabase';
    import { postAdminAction } from '../../lib/admin-client';
    const sb = getSupabaseBrowser();

    let currentFilter = 'semua';
    let allPesan: any[] = [];
    let currentFilteredRows: any[] = [];
    let searchQuery = '';
    let activeInquiry: any = null;
    let modal: any = null;

    // Status disederhanakan: BARU, TERKONFIRMASI, BATAL
    const STATUSES = [
      { value: 'baru', label: 'BARU' },
      { value: 'terkonfirmasi', label: 'TERKONFIRMASI' },
      { value: 'batal', label: 'BATAL' },
    ];

    function createModal(modalId: string) {
      const el = document.getElementById(modalId);
      if (!el) return { show() {}, hide() {} };

      function hide() {
        const BS = (window as any).bootstrap?.Modal;
        if (BS) {
          try {
            const inst = BS.getInstance ? BS.getInstance(el) : null;
            if (inst) { inst.hide(); return; }
          } catch {}
        }
        el.classList.remove('show');
        el.style.display = 'none';
        el.setAttribute('aria-hidden', 'true');
        el.removeAttribute('aria-modal');
        const remaining = Array.from(document.querySelectorAll<HTMLElement>('.modal.show'))
          .filter(m => m !== el && m.style.display !== 'none');
        if (remaining.length === 0) {
          document.body.classList.remove('modal-open');
          document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
        }
      }

      el.querySelectorAll('[data-bs-dismiss="modal"], .btn-close').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          hide();
        });
      });

      el.addEventListener('click', (e) => {
        if (e.target === el) hide();
      });

      return {
        show() {
          const BS = (window as any).bootstrap?.Modal;
          if (BS) {
            try {
              const inst = BS.getOrCreateInstance ? BS.getOrCreateInstance(el) : new BS(el);
              inst.show();
              return;
            } catch {}
          }
          el.classList.add('show');
          el.style.display = 'block';
          el.removeAttribute('aria-hidden');
          el.setAttribute('aria-modal', 'true');
          document.body.classList.add('modal-open');
          let backdrop = document.querySelector('.modal-backdrop');
          if (!backdrop) {
            backdrop = document.createElement('div');
            backdrop.className = 'modal-backdrop fade show';
            document.body.appendChild(backdrop);
          }
        },
        hide,
      };
    }

    function isSameDay(d1: Date, d2: Date): boolean {
      return (
        d1.getFullYear() === d2.getFullYear() &&
        d1.getMonth() === d2.getMonth() &&
        d1.getDate() === d2.getDate()
      );
    }

    function checkDateFilter(recordDateStr: string, filterType: string): boolean {
      if (!recordDateStr) return false;
      const d = new Date(recordDateStr);
      if (isNaN(d.getTime())) return false;

      const now = new Date();

      if (filterType === 'hari_ini') {
        return isSameDay(d, now);
      }

      if (filterType === 'kemarin') {
        const yesterday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
        return isSameDay(d, yesterday);
      }

      if (filterType === '1_minggu') {
        const sevenDaysAgo = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 7, 0, 0, 0, 0);
        return d >= sevenDaysAgo;
      }

      // 'semua'
      return true;
    }

    function formatWaktu(dateStr: string): string {
      if (!dateStr) return '—';
      const d = new Date(dateStr);
      if (isNaN(d.getTime())) return '—';
      const now = new Date();
      const timePart = d.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit' }).replace('.', ':');

      if (isSameDay(d, now)) {
        return `<span style="color:var(--sk-admin-primary);font-weight:700;">Hari ini</span>, ${timePart}`;
      }
      const yesterday = new Date(now.getFullYear(), now.getMonth(), now.getDate() - 1);
      if (isSameDay(d, yesterday)) {
        return `<span style="font-weight:600;">Kemarin</span>, ${timePart}`;
      }
      const datePart = d.toLocaleDateString('id-ID', { day: '2-digit', month: 'short', year: 'numeric' });
      return `${datePart}, ${timePart}`;
    }

    function esc(str: any): string {
      if (str === null || str === undefined) return '';
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function syncBadgeWithLocal() {
      const unread = allPesan.filter(p => p.status === 'baru').length;
      if (typeof (window as any).refreshUnreadBadge === 'function') {
        (window as any).refreshUnreadBadge(unread);
      }
    }

    // Generator Template WhatsApp berdasarkan data & status
    function getWhatsAppTemplate(row: any, targetStatus?: string): string {
      const status = targetStatus || (row.status === 'selesai' ? 'terkonfirmasi' : row.status) || 'baru';
      const nama = row.nama ? String(row.nama).trim() : 'Kak';
      const instansi = row.perusahaan ? ` dari *${String(row.perusahaan).trim()}*` : '';
      const produk = row.produk_diminati ? String(row.produk_diminati).trim() : 'Paket Seminar Kit';
      const jumlah = row.jumlah ? `${Number(row.jumlah).toLocaleString('id-ID')} pcs` : null;
      const tanggal = row.tanggal_dibutuhkan || null;
      const catatan = row.pesan ? `"${String(row.pesan).trim()}"` : null;

      if (status === 'terkonfirmasi' || status === 'selesai') {
        return [
          `Halo Kak *${nama}*${instansi}, salam hangat dari *seminarkit*! ✨`,
          ``,
          `Kabar baik! Permintaan penawaran Anda telah *TERKONFIRMASI*:`,
          `📦 *Produk:* ${produk}`,
          jumlah ? `🔢 *Jumlah:* ${jumlah}` : null,
          tanggal ? `🗓️ *Target Kebutuhan:* ${tanggal}` : null,
          catatan ? `📝 *Catatan Klien:* ${catatan}` : null,
          ``,
          `Pesanan Anda sudah masuk dalam jadwal antrean tim produksi kami. Kami sedang menyiapkan draf invoice resmi serta preview digital mockup logo untuk persetujuan akhir sebelum proses produksi dimulai.`,
          ``,
          `Jika ada tambahan logo, detail sablon/laser, atau berkas pendukung lainnya, silakan langsung kirimkan di sini ya Kak. Terima kasih banyak atas kepercayaan Anda pada seminarkit! 🙏`,
        ].filter(v => v !== null).join('\n');
      }

      if (status === 'batal') {
        return [
          `Halo Kak *${nama}*${instansi}, salam dari *seminarkit*.`,
          ``,
          `Menindaklanjuti permohonan penawaran paket seminar kit untuk:`,
          `📦 *Produk:* ${produk}`,
          jumlah ? `🔢 *Jumlah:* ${jumlah}` : null,
          catatan ? `📝 *Catatan:* ${catatan}` : null,
          ``,
          `Saat ini status permintaan penawaran Anda telah kami catat sebagai *BATAL* sesuai konfirmasi/evaluasi terbaru.`,
          ``,
          `Terima kasih banyak atas waktu dan komunikasi yang telah terjalin. Apabila di masa mendatang Anda membutuhkan paket seminar kit, merchandise, atau souvenir kantor untuk agenda lainnya, pintu kami selalu terbuka untuk melayani Anda kembali.`,
          ``,
          `Semoga sukses dan lancar selalu untuk seluruh kegiatan Anda! 🙏✨`,
        ].filter(v => v !== null).join('\n');
      }

      // Default Status: 'baru' / Follow Up Awal
      return [
        `Halo Kak *${nama}*${instansi}, salam hangat dari *seminarkit*! 👋`,
        ``,
        `Terima kasih telah menghubungi kami. Kami telah menerima rincian permintaan penawaran Anda:`,
        `📦 *Produk:* ${produk}`,
        jumlah ? `🔢 *Jumlah:* ${jumlah}` : null,
        tanggal ? `🗓️ *Dibutuhkan Tanggal:* ${tanggal}` : null,
        catatan ? `📝 *Catatan Klien:* ${catatan}` : null,
        ``,
        `Simulasi harga terbaik dan estimasi waktu produksi sedang kami siapkan. Boleh kami konfirmasi apakah Anda sudah memiliki file logo acara/instansi (format PNG/PDF/vektor) yang ingin dicantumkan pada produk tersebut?`,
        ``,
        `Kami siap membantu konsultasi desain dan penawaran terbaik untuk Anda. Terima kasih! 😊`,
      ].filter(v => v !== null).join('\n');
    }

    function updateSendButton(cleanWa: string, text: string) {
      const btn = document.getElementById('btn-send-wa') as HTMLAnchorElement | null;
      if (btn) {
        btn.href = `https://wa.me/${cleanWa}?text=${encodeURIComponent(text)}`;
      }
    }

    function openWaModal(row: any) {
      if (!modal) return;
      activeInquiry = row;

      let cleanWa = String(row.no_wa || '').replace(/\D/g, '');
      if (cleanWa.startsWith('0')) cleanWa = '62' + cleanWa.slice(1);
      else if (!cleanWa.startsWith('62')) cleanWa = '62' + cleanWa;

      // Subtitle
      const subEl = document.getElementById('wa-modal-sub');
      if (subEl) {
        subEl.textContent = `${row.nama ?? 'Customer'}${row.perusahaan ? ` (${row.perusahaan})` : ''} • +${cleanWa}`;
      }

      // Context Box
      const metaEl = document.getElementById('wa-modal-meta');
      if (metaEl) {
        metaEl.innerHTML = `
          <div><strong>Produk:</strong> ${esc(row.produk_diminati || 'Konsultasi')}</div>
          <div><strong>Jumlah:</strong> ${row.jumlah ? `${Number(row.jumlah).toLocaleString('id-ID')} pcs` : '—'}</div>
          <div><strong>Dibutuhkan:</strong> ${esc(row.tanggal_dibutuhkan || '—')}</div>
          ${row.pesan ? `<div style="flex-basis:100%;"><strong>Catatan:</strong> <em>"${esc(row.pesan)}"</em></div>` : ''}
        `;
      }

      // Default status
      const currentStatus = (row.status === 'selesai' || row.status === 'terkonfirmasi')
        ? 'terkonfirmasi'
        : (row.status === 'batal' ? 'batal' : 'baru');

      // Update Tabs Style
      document.querySelectorAll('#wa-template-tabs [data-status]').forEach(tab => {
        const s = (tab as HTMLElement).dataset.status;
        if (s === currentStatus) {
          tab.classList.add('active');
          (tab as HTMLElement).style.background = '#1B3131';
          (tab as HTMLElement).style.color = '#fff';
        } else {
          tab.classList.remove('active');
          (tab as HTMLElement).style.background = '#fff';
          (tab as HTMLElement).style.color = 'var(--sk-admin-text-main)';
        }
      });

      // Generate text
      const textarea = document.getElementById('wa-message-text') as HTMLTextAreaElement | null;
      const initialText = getWhatsAppTemplate(row, currentStatus);
      if (textarea) textarea.value = initialText;

      updateSendButton(cleanWa, initialText);
      modal.show();
    }

    async function loadPesan() {
      try {
        const res = await fetch('/api/admin/manage?table=inquiries', { cache: 'no-store' }).then(r => r.json());
        if (res.ok && Array.isArray(res.data)) {
          allPesan = res.data.map(p => ({
            ...p,
            status: p.status === 'selesai' ? 'terkonfirmasi' : p.status,
          }));
        } else {
          const { data } = await sb
            .from('inquiries')
            .select('*')
            .order('created_at', { ascending: false })
            .limit(300);
          allPesan = (data ?? []).map(p => ({
            ...p,
            status: p.status === 'selesai' ? 'terkonfirmasi' : p.status,
          }));
        }
      } catch {
        const { data } = await sb
          .from('inquiries')
          .select('*')
          .order('created_at', { ascending: false })
          .limit(300);
        allPesan = (data ?? []).map(p => ({
          ...p,
          status: p.status === 'selesai' ? 'terkonfirmasi' : p.status,
        }));
      }

      syncBadgeWithLocal();
      applyFilterAndRender();
    }

    function applyFilterAndRender() {
      let filtered = allPesan;

      // 1. Date filter
      if (currentFilter && currentFilter !== 'semua') {
        filtered = filtered.filter(r => checkDateFilter(r.created_at, currentFilter));
      }

      // 2. Search query filter
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        filtered = filtered.filter(r =>
          (r.nama && r.nama.toLowerCase().includes(q)) ||
          (r.perusahaan && r.perusahaan.toLowerCase().includes(q)) ||
          (r.no_wa && r.no_wa.toLowerCase().includes(q)) ||
          (r.produk_diminati && r.produk_diminati.toLowerCase().includes(q)) ||
          (r.pesan && r.pesan.toLowerCase().includes(q)) ||
          (r.status && r.status.toLowerCase().includes(q))
        );
      }

      currentFilteredRows = filtered;
      renderTable(filtered);
    }

    function renderTable(rows: any[]) {
      const tbody = document.getElementById('pesan-tbody')!;
      const countEl = document.getElementById('pesan-count');
      if (countEl) countEl.textContent = `${rows.length} permintaan ditemukan`;

      if (!rows.length) {
        const filterLabels: Record<string, string> = {
          hari_ini: 'Hari Ini',
          kemarin: 'Kemarin',
          '1_minggu': '1 Minggu yang Lalu',
          semua: 'Semua',
        };
        const currentLabel = filterLabels[currentFilter] || 'Semua';

        tbody.innerHTML = `
          <tr>
            <td colspan="7" class="text-center py-5">
              <div style="max-width:420px;margin:0 auto;">
                <div style="width:48px;height:48px;border-radius:50%;background:var(--sk-admin-surface-subtle);border:1px solid var(--sk-admin-card-border);display:inline-flex;align-items:center;justify-content:center;margin-bottom:12px;color:var(--sk-admin-primary);">
                  <svg viewBox="0 0 24 24" style="width:22px;height:22px;stroke:currentColor;stroke-width:2;fill:none;stroke-linecap:round;stroke-linejoin:round;">
                    <circle cx="12" cy="12" r="10"></circle>
                    <polyline points="12 6 12 12 14 14"></polyline>
                  </svg>
                </div>
                <p style="font-weight:700;color:var(--sk-admin-primary);margin-bottom:4px;font-size:1rem;">Tidak ada pesan (${esc(currentLabel)})</p>
                <p style="font-size:.875rem;color:var(--sk-admin-text-muted);margin-bottom:14px;">
                  ${searchQuery 
                    ? `Tidak ditemukan pesan yang cocok dengan kata kunci "${esc(searchQuery)}".`
                    : allPesan.length > 0 
                      ? `Belum ada pesan untuk periode ${esc(currentLabel)}. Terdapat total ${allPesan.length} pesan di database.`
                      : 'Belum ada permintaan penawaran yang tercatat di database.'}
                </p>
                ${allPesan.length > 0 && currentFilter !== 'semua' ? `
                  <button type="button" id="btn-show-all-empty" class="sk-pill-btn sk-pill-btn--primary" style="font-size:.8125rem;padding:7px 20px;">
                    Lihat Semua Pesan (${allPesan.length})
                  </button>
                ` : ''}
              </div>
            </td>
          </tr>
        `;

        document.getElementById('btn-show-all-empty')?.addEventListener('click', () => {
          const btn = document.querySelector('#filter-bar [data-filter="semua"]') as HTMLButtonElement | null;
          if (btn) btn.click();
        });
        return;
      }

      tbody.innerHTML = rows.map(r => {
        const cleanWa = String(r.no_wa || '').replace(/\D/g, '');
        const waktuHtml = formatWaktu(r.created_at);
        const currentStatus = (r.status === 'selesai' || r.status === 'terkonfirmasi')
          ? 'terkonfirmasi'
          : (r.status === 'batal' ? 'batal' : 'baru');

        return `
          <tr>
            <td style="font-size:.8125rem;white-space:nowrap;color:var(--sk-admin-text-muted);">
              ${waktuHtml}
            </td>
            <td>
              <div style="font-weight:700;color:var(--sk-admin-primary);">${esc(r.nama ?? 'Tanpa Nama')}</div>
              <div style="font-size:.8125rem;color:var(--sk-admin-text-muted);">${esc(r.perusahaan ?? 'Pribadi')}</div>
              ${r.email ? `<div style="font-size:.75rem;color:var(--sk-admin-text-muted);">${esc(r.email)}</div>` : ''}
              ${r.pesan ? `
                <div style="font-size:.8125rem;background:var(--sk-admin-surface-subtle);border:1px solid var(--sk-admin-card-border);padding:6px 12px;border-radius:10px;margin-top:6px;max-width:380px;">
                  <span style="font-weight:600;font-size:.75rem;color:var(--sk-admin-text-muted);display:block;">Catatan Klien:</span>
                  ${esc(r.pesan)}
                </div>
              ` : ''}
            </td>
            <td>
              <button
                type="button"
                class="btn-balas-wa-link"
                data-id="${esc(r.id)}"
                style="background:none;border:none;padding:0;color:var(--sk-admin-primary);font-weight:600;text-decoration:underline;cursor:pointer;font-size:inherit;"
              >
                ${esc(r.no_wa ?? '—')}
              </button>
            </td>
            <td>
              <span style="font-weight:500;">${esc(r.produk_diminati ?? 'Konsultasi Umum')}</span>
              ${r.tanggal_dibutuhkan ? `<div style="font-size:.75rem;color:var(--sk-admin-text-muted);">Dibutuhkan: ${esc(r.tanggal_dibutuhkan)}</div>` : ''}
            </td>
            <td style="font-variant-numeric:tabular-nums;font-weight:600;">
              ${r.jumlah ? `${Number(r.jumlah).toLocaleString('id-ID')} pcs` : '—'}
            </td>
            <td>
              <select
                class="form-select sk-input status-select"
                data-id="${esc(r.id)}"
                style="min-height:34px;font-size:.8125rem;border-radius:var(--sk-admin-radius-pill);padding:4px 12px;font-weight:600;"
              >
                ${STATUSES.map(s => `<option value="${s.value}"${s.value === currentStatus ? ' selected' : ''}>${s.label}</option>`).join('')}
              </select>
            </td>
            <td>
              <button
                type="button"
                class="sk-pill-btn btn-balas-wa"
                data-id="${esc(r.id)}"
                style="padding:6px 14px;font-size:.75rem;width:100%;cursor:pointer;display:inline-flex;align-items:center;justify-content:center;gap:4px;"
              >
                <span>Balas WA</span>
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
              </button>
            </td>
          </tr>
        `;
      }).join('');

      // Status change listener
      tbody.querySelectorAll<HTMLSelectElement>('.status-select').forEach(sel => {
        sel.addEventListener('change', async () => {
          const id = sel.dataset.id!;
          const newStatus = sel.value;
          
          const item = allPesan.find(item => String(item.id) === id);
          if (item) item.status = newStatus;
          syncBadgeWithLocal();

          try {
            await postAdminAction('update_inquiry_status', { id, status: newStatus });
          } catch {}
          try {
            const sbStatus = newStatus === 'terkonfirmasi' ? 'selesai' : newStatus;
            await sb.from('inquiries').update({ status: sbStatus }).eq('id', id);
          } catch {}
        });
      });

      // Balas WA modal click listeners
      tbody.querySelectorAll<HTMLElement>('.btn-balas-wa, .btn-balas-wa-link').forEach(btn => {
        btn.addEventListener('click', () => {
          const id = btn.dataset.id!;
          const row = allPesan.find(item => String(item.id) === id);
          if (row) {
            openWaModal(row);
          }
        });
      });
    }

    // Modal template tabs switcher
    document.getElementById('wa-template-tabs')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-status]') as HTMLButtonElement | null;
      if (!btn || !activeInquiry) return;

      const targetStatus = btn.dataset.status;
      document.querySelectorAll('#wa-template-tabs [data-status]').forEach(tab => {
        tab.classList.remove('active');
        (tab as HTMLElement).style.background = '#fff';
        (tab as HTMLElement).style.color = 'var(--sk-admin-text-main)';
      });
      btn.classList.add('active');
      btn.style.background = '#1B3131';
      btn.style.color = '#fff';

      const newText = getWhatsAppTemplate(activeInquiry, targetStatus);
      const textarea = document.getElementById('wa-message-text') as HTMLTextAreaElement | null;
      if (textarea) textarea.value = newText;

      let cleanWa = String(activeInquiry.no_wa || '').replace(/\D/g, '');
      if (cleanWa.startsWith('0')) cleanWa = '62' + cleanWa.slice(1);
      else if (!cleanWa.startsWith('62')) cleanWa = '62' + cleanWa;
      updateSendButton(cleanWa, newText);
    });

    // Real-time input listener on WA message textarea
    document.getElementById('wa-message-text')?.addEventListener('input', (e) => {
      if (!activeInquiry) return;
      const text = (e.target as HTMLTextAreaElement).value;
      let cleanWa = String(activeInquiry.no_wa || '').replace(/\D/g, '');
      if (cleanWa.startsWith('0')) cleanWa = '62' + cleanWa.slice(1);
      else if (!cleanWa.startsWith('62')) cleanWa = '62' + cleanWa;
      updateSendButton(cleanWa, text);
    });

    // Copy to clipboard
    document.getElementById('btn-copy-wa')?.addEventListener('click', async () => {
      const textarea = document.getElementById('wa-message-text') as HTMLTextAreaElement | null;
      if (!textarea) return;
      try {
        await navigator.clipboard.writeText(textarea.value);
        const badge = document.getElementById('wa-copy-badge');
        if (badge) {
          badge.style.display = 'inline';
          setTimeout(() => { badge.style.display = 'none'; }, 2000);
        }
      } catch {
        textarea.select();
        document.execCommand('copy');
      }
    });

    // Filter buttons listener
    document.getElementById('filter-bar')?.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest('[data-filter]') as HTMLButtonElement | null;
      if (!btn) return;
      currentFilter = btn.dataset.filter ?? 'hari_ini';
      document.querySelectorAll('#filter-bar [data-filter]').forEach(b => {
        b.classList.remove('active');
      });
      btn.classList.add('active');
      applyFilterAndRender();
    });

    // Real-time search filter
    document.getElementById('pesan-search')?.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim();
      applyFilterAndRender();
    });

    // CSV Export
    document.getElementById('export-csv')?.addEventListener('click', () => {
      const sanitizeCell = (val: string) => {
        const s = String(val ?? '').replace(/"/g, '""');
        return /^[=+\-@]/.test(s) ? `'${s}` : s;
      };
      const rowsToExport = currentFilteredRows.length > 0 ? currentFilteredRows : allPesan;
      const rows = [
        ['Waktu','Nama','Perusahaan','WA','Email','Produk','Jumlah','Tanggal Dibutuhkan','Status','Pesan'],
        ...rowsToExport.map(r => [
          r.created_at, r.nama, r.perusahaan, r.no_wa, r.email,
          r.produk_diminati, r.jumlah, r.tanggal_dibutuhkan, r.status, r.pesan,
        ].map(v => `"${sanitizeCell(v ?? '')}"`)
        ),
      ];
      const csv = rows.map(r => r.join(',')).join('\r\n');
      const blob = new Blob(['\ufeff' + csv], { type: 'text/csv;charset=utf-8;' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url; a.download = `inquiries-${currentFilter}-${Date.now()}.csv`; a.click();
      URL.revokeObjectURL(url);
    });

    // Read initial search query from URL if navigated from global search
    const urlParams = new URLSearchParams(window.location.search);
    const initSearch = urlParams.get('search');
    if (initSearch) {
      searchQuery = initSearch;
      const sInput = document.getElementById('pesan-search') as HTMLInputElement | null;
      if (sInput) sInput.value = initSearch;
      currentFilter = 'semua';
      document.querySelectorAll('#filter-bar [data-filter]').forEach(b => b.classList.remove('active'));
      document.querySelector('#filter-bar [data-filter="semua"]')?.classList.add('active');
    }

    // Inisialisasi modal & load pesan
    modal = createModal('waModal');
    loadPesan();
  </script>
</AdminLayout>
