---
// src/pages/admin/faq.astro
export const prerender = false;

import AdminLayout from '../../layouts/AdminLayout.astro';
---
<AdminLayout title="Kelola FAQ" activePage="faq">
  <!-- Top Action & Search Bar -->
  <div class="sk-modern-card mb-3 p-3">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div class="d-flex flex-wrap align-items-center gap-2">
        <button type="button" id="btn-tambah" class="sk-pill-btn" style="padding:8px 20px;font-size:.8125rem;">
          + Tambah FAQ
        </button>
      </div>

      <div class="d-flex align-items-center gap-2 ms-auto">
        <div class="sk-search-pill" style="width:260px;">
          <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            type="search"
            id="faq-search"
            placeholder="Cari pertanyaan / jawaban…"
            style="padding-top:8px;padding-bottom:8px;font-size:.8125rem;"
          />
        </div>
      </div>
    </div>
  </div>

  <div id="faq-notice" class="sk-notice mb-3" role="alert" aria-live="polite" style="display:none;"></div>

  <!-- FAQ Table Card -->
  <div class="sk-modern-card">
    <div class="sk-card-header-row">
      <h2 class="sk-card-title">Daftar Pertanyaan Umum (FAQ)</h2>
      <span id="faq-count" style="font-size:.8125rem;color:var(--sk-admin-text-muted);">Memuat FAQ…</span>
    </div>

    <div class="sk-modern-table-wrap">
      <table class="sk-modern-table">
        <thead>
          <tr>
            <th style="width:60px;">Urutan</th>
            <th style="width:35%;">Pertanyaan</th>
            <th>Jawaban Lengkap</th>
            <th style="width:100px;">Status</th>
            <th style="width:140px;">Aksi</th>
          </tr>
        </thead>
        <tbody id="faq-tbody">
          <tr>
            <td colspan="5" class="text-center py-5" style="color:var(--sk-admin-text-muted);">
              Memuat pertanyaan FAQ…
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Modal Tambah/Edit FAQ -->
  <div class="modal fade" id="faqModal" tabindex="-1" aria-label="Form FAQ" aria-hidden="true">
    <div class="modal-dialog modal-lg">
      <div class="modal-content">
        <div class="modal-header">
          <h2 class="modal-title h5 font-weight-bold" id="modal-faq-title" style="color:var(--sk-admin-primary);">Tambah FAQ</h2>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Tutup"></button>
        </div>
        <div class="modal-body p-4">
          <form id="faq-form">
            <input type="hidden" id="faq-id" />
            <div class="row g-3">
              <div class="col-12">
                <label for="f-pertanyaan" class="sk-label">Pertanyaan <span>*</span></label>
                <input type="text" id="f-pertanyaan" class="form-control sk-input" required placeholder="Berapa minimal order seminar kit?" />
              </div>
              <div class="col-12">
                <label for="f-jawaban" class="sk-label">Jawaban <span>*</span></label>
                <textarea id="f-jawaban" class="form-control sk-input" rows="5" required placeholder="Minimal order mulai dari 50 pcs untuk paket standar. Untuk pesanan custom khusus dapat dikonsultasikan langsung..."></textarea>
              </div>
              <div class="col-md-6">
                <label for="f-urutan" class="sk-label">Urutan Tampil</label>
                <input type="number" id="f-urutan" class="form-control sk-input" value="0" />
              </div>
              <div class="col-md-6 d-flex align-items-end pb-1">
                <div class="form-check">
                  <input class="form-check-input" type="checkbox" id="f-published" checked />
                  <label class="form-check-label font-weight-bold" for="f-published" style="font-size:.875rem;">Terbitkan di Halaman FAQ</label>
                </div>
              </div>
            </div>
          </form>
        </div>
        <div class="modal-footer">
          <button type="button" class="sk-pill-btn sk-pill-btn--outline" data-bs-dismiss="modal" style="padding:6px 18px;font-size:.8125rem;">Batal</button>
          <button type="button" id="faq-save" class="sk-pill-btn" style="padding:6px 20px;font-size:.8125rem;">Simpan FAQ</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { getSupabaseBrowser } from '../../lib/supabase';

    const sb = getSupabaseBrowser();
    let modal: any;
    let allFaqs: any[] = [];
    let searchFaqQuery = '';

    function createModal(modalId: string) {
      const el = document.getElementById(modalId);
      if (!el) return { show() {}, hide() {} };

      function hide() {
        const BS = (window as any).bootstrap?.Modal;
        if (BS) {
          try {
            const inst = BS.getInstance ? BS.getInstance(el) : null;
            if (inst) { inst.hide(); return; }
          } catch {}
        }
        el.classList.remove('show');
        el.style.display = 'none';
        el.setAttribute('aria-hidden', 'true');
        el.removeAttribute('aria-modal');
        const remaining = Array.from(document.querySelectorAll<HTMLElement>('.modal.show'))
          .filter(m => m !== el && m.style.display !== 'none');
        if (remaining.length === 0) {
          document.body.classList.remove('modal-open');
          document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
        }
      }

      el.querySelectorAll('[data-bs-dismiss="modal"], .btn-close').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.preventDefault();
          hide();
        });
      });

      el.addEventListener('click', (e) => {
        if (e.target === el) hide();
      });

      return {
        show() {
          const BS = (window as any).bootstrap?.Modal;
          if (BS) {
            try {
              const inst = BS.getOrCreateInstance ? BS.getOrCreateInstance(el) : new BS(el);
              inst.show();
              return;
            } catch {}
          }
          el.classList.add('show');
          el.style.display = 'block';
          el.setAttribute('aria-modal', 'true');
          el.removeAttribute('aria-hidden');
          document.body.classList.add('modal-open');
          let backdrop = document.querySelector('.modal-backdrop');
          if (!backdrop) {
            backdrop = document.createElement('div');
            backdrop.className = 'modal-backdrop fade show';
            backdrop.addEventListener('click', hide);
            document.body.appendChild(backdrop);
          }
        },
        hide
      };
    }

    function esc(str: string | null | undefined): string {
      if (!str) return '';
      return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    async function loadFaq() {
      try {
        const res = await fetch('/api/admin/manage?table=faqs').then(r => r.json());
        if (res.ok && Array.isArray(res.data)) {
          allFaqs = res.data;
        } else {
          const { data } = await sb.from('faqs').select('*').order('urutan');
          allFaqs = data ?? [];
        }
      } catch {
        const { data } = await sb.from('faqs').select('*').order('urutan');
        allFaqs = data ?? [];
      }
      applyFaqFilterAndRender();
    }

    function applyFaqFilterAndRender() {
      let filtered = allFaqs;
      if (searchFaqQuery) {
        const q = searchFaqQuery.toLowerCase();
        filtered = filtered.filter(f =>
          (f.pertanyaan && f.pertanyaan.toLowerCase().includes(q)) ||
          (f.jawaban && f.jawaban.toLowerCase().includes(q))
        );
      }
      renderFaqTable(filtered);
    }

    function renderFaqTable(items: any[]) {
      const tbody = document.getElementById('faq-tbody')!;
      const countEl = document.getElementById('faq-count');
      if (countEl) countEl.textContent = `${items.length} pertanyaan terdaftar`;

      if (!items.length) {
        tbody.innerHTML = `
          <tr>
            <td colspan="5" class="text-center py-5">
              <p style="font-weight:700;color:var(--sk-admin-primary);margin-bottom:4px;">Belum ada pertanyaan FAQ</p>
              <p style="font-size:.875rem;color:var(--sk-admin-text-muted);margin:0;">Klik "+ Tambah FAQ" untuk menambahkan tanya jawab baru.</p>
            </td>
          </tr>
        `;
        return;
      }

      tbody.innerHTML = items.map(f => `
        <tr>
          <td style="font-variant-numeric:tabular-nums;color:var(--sk-admin-text-muted);">${f.urutan}</td>
          <td>
            <strong style="color:var(--sk-admin-primary);">${esc(f.pertanyaan)}</strong>
          </td>
          <td>
            <div style="font-size:.8125rem;color:var(--sk-admin-text-main);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;max-width:440px;">
              ${esc(f.jawaban)}
            </div>
          </td>
          <td>
            <span class="sk-status-pill ${f.is_published ? 'sk-status-pill--success' : 'sk-status-pill--muted'}">
              <span class="sk-status-dot"></span>
              ${f.is_published ? 'Aktif' : 'Nonaktif'}
            </span>
          </td>
          <td>
            <div class="d-flex align-items-center gap-1">
              <button type="button" class="btn-sk-action edit-btn" data-id="${esc(f.id)}">Edit</button>
              <button type="button" class="btn-sk-action btn-sk-action--danger delete-btn" data-id="${esc(f.id)}">Hapus</button>
            </div>
          </td>
        </tr>
      `).join('');

      // Edit handlers
      tbody.querySelectorAll<HTMLButtonElement>('.edit-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          let f = allFaqs.find(x => x.id === btn.dataset.id);
          if (!f) {
            try {
              const res = await sb.from('faqs').select('*').eq('id', btn.dataset.id!).single();
              f = res.data;
            } catch {}
          }
          if (!f) return;
          (document.getElementById('faq-id') as HTMLInputElement).value = f.id;
          (document.getElementById('f-pertanyaan') as HTMLInputElement).value = f.pertanyaan;
          (document.getElementById('f-jawaban') as HTMLTextAreaElement).value = f.jawaban;
          (document.getElementById('f-urutan') as HTMLInputElement).value = f.urutan;
          (document.getElementById('f-published') as HTMLInputElement).checked = f.is_published;
          document.getElementById('modal-faq-title')!.textContent = 'Edit FAQ';
          modal.show();
        });
      });

      // Delete handlers
      tbody.querySelectorAll<HTMLButtonElement>('.delete-btn').forEach(btn => {
        btn.addEventListener('click', async () => {
          if (!confirm('Yakin ingin menghapus FAQ ini?')) return;
          try {
            await fetch('/api/admin/manage', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ action: 'delete_faq', payload: { id: btn.dataset.id } })
            });
          } catch {}
          try { await sb.from('faqs').delete().eq('id', btn.dataset.id!); } catch {}
          loadFaq();
        });
      });
    }

    document.getElementById('faq-search')?.addEventListener('input', (e) => {
      searchFaqQuery = (e.target as HTMLInputElement).value.trim();
      applyFaqFilterAndRender();
    });

    document.getElementById('btn-tambah')?.addEventListener('click', () => {
      (document.getElementById('faq-id') as HTMLInputElement).value = '';
      (document.getElementById('faq-form') as HTMLFormElement).reset();
      (document.getElementById('f-published') as HTMLInputElement).checked = true;
      (document.getElementById('f-urutan') as HTMLInputElement).value = '0';
      document.getElementById('modal-faq-title')!.textContent = 'Tambah FAQ';
      modal.show();
    });

    document.getElementById('faq-save')?.addEventListener('click', async () => {
      const id = (document.getElementById('faq-id') as HTMLInputElement).value;
      const pertanyaan = (document.getElementById('f-pertanyaan') as HTMLInputElement).value.trim();
      const jawaban = (document.getElementById('f-jawaban') as HTMLTextAreaElement).value.trim();

      if (!pertanyaan || !jawaban) {
        alert('Pertanyaan dan Jawaban wajib diisi.');
        return;
      }

      const payload: any = {
        id: id || undefined,
        pertanyaan,
        jawaban,
        urutan: Number((document.getElementById('f-urutan') as HTMLInputElement).value) || 0,
        is_published: (document.getElementById('f-published') as HTMLInputElement).checked,
      };

      const saveBtn = document.getElementById('faq-save') as HTMLButtonElement | null;
      if (saveBtn) saveBtn.disabled = true;

      try {
        await fetch('/api/admin/manage', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ action: 'save_faq', payload })
        });
      } catch (e) {
        console.warn('API save error:', e);
      }

      try {
        if (id) await sb.from('faqs').update(payload).eq('id', id);
        else await sb.from('faqs').insert(payload);
      } catch {}

      if (saveBtn) saveBtn.disabled = false;
      modal.hide();
      loadFaq();
    });

    // Init modal & load data
    (async () => {
      modal = createModal('faqModal');

      const urlParams = new URLSearchParams(window.location.search);
      const initSearch = urlParams.get('search');
      if (initSearch) {
        searchFaqQuery = initSearch;
        const sInput = document.getElementById('faq-search') as HTMLInputElement | null;
        if (sInput) sInput.value = initSearch;
      }
      if (urlParams.get('action') === 'tambah') {
        setTimeout(() => document.getElementById('btn-tambah')?.click(), 300);
      }

      await loadFaq();
    })();
  </script>
</AdminLayout>
