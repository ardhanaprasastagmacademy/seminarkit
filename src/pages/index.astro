---
// src/pages/index.astro
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import CTA from '../components/CTA.astro';
import {
  getSiteSettings,
  getFeaturedProducts,
  getCategories,
  getHomeGallery,
  getTestimonials,
  getFaqs,
} from '../lib/queries';
import { hero, tentangSingkat, keunggulan4 } from '../data/site';
import { buildWaFromPage, buildWaUrl, buildWaFromProduct } from '../lib/wa';
import { formatRupiah } from '../lib/format';
import { organizationSchema, websiteSchema, faqSchema } from '../lib/seo';

// Fetch all backend data directly without altering any schema or queries
const settings = await getSiteSettings();
const products = await getFeaturedProducts(3);
const categories = await getCategories();
const categoryMap = new Map(categories.map(c => [c.id, c.nama]));
const gallery = await getHomeGallery();
const testimonials = await getTestimonials();
const fallbackTestimonials = [
  {
    nama: 'Rian Hidayat',
    jabatan: 'Head of People Operations',
    perusahaan: 'PT Telekomunikasi Nusantara',
    isi: 'Pemesanan 350 paket seminar kit selesai 3 hari sebelum tenggat waktu acara. Kualitas finishing bahan kulitnya sangat memuaskan dan disukai para peserta dewan direksi.',
    rating: 5,
  },
  {
    nama: 'dr. Fitriani Prasetyo',
    jabatan: 'Ketua Panitia Simposium Nasional',
    perusahaan: 'Ikatan Ahli Kesehatan Masyarakat',
    isi: 'Komunikasi sangat responsif via WhatsApp. Sampel produk dikirimkan cepat sehingga panitia yakin sebelum produksi massal 800 pcs. Sangat profesional.',
    rating: 5,
  },
  {
    nama: 'Darmawan Santosa',
    jabatan: 'Procurement Specialist',
    perusahaan: 'Astra Internasional Partner',
    isi: 'Transparansi rincian harga per komponen dan ketepatan jumlah barang tanpa ada yang cacat. Rekomendasi vendor seminar kit terbaik di Jakarta.',
    rating: 5,
  },
  {
    nama: 'Nabila Syakira',
    jabatan: 'Event Coordinator',
    perusahaan: 'Yayasan Pendidikan Global',
    isi: 'Totebag dan tumblernya ramah lingkungan sesuai tema acara kami. Kemasan rapi dan sudah dikelompokkan per sesi sehingga pembagian ke peserta berjalan mulus.',
    rating: 5,
  },
];
const displayTestimonials = (testimonials && testimonials.length >= 2) ? testimonials : fallbackTestimonials;
const fallbackGallery = [
  {
    id: '1',
    judul: 'Paket Seminar Kit Premium',
    kategori: 'Seminar Kit BUMN',
    gambar_url: '/images/seminakit-set.webp',
    alt_text: 'Paket seminar kit premium untuk instansi dan korporasi',
  },
  {
    id: '2',
    judul: 'Tumbler Termos Laser Grafir',
    kategori: 'Souvenir Instansi',
    gambar_url: '/images/tumble.webp',
    alt_text: 'Tumbler termos custom logo grafir rapi',
  },
  {
    id: '3',
    judul: 'Totebag Kanvas Pelatihan',
    kategori: 'Pelatihan Nasional',
    gambar_url: '/images/totebag.webp',
    alt_text: 'Totebag kanvas twill ramah lingkungan',
  },
  {
    id: '4',
    judul: 'Buku Agenda Kulit Sintetis',
    kategori: 'Stationery Eksklusif',
    gambar_url: '/images/notebook.webp',
    alt_text: 'Buku agenda kerja kulit doff minimalis',
  },
];
const displayGallery = (gallery && gallery.length > 0) ? gallery : fallbackGallery;
const faqs = await getFaqs();
const fallbackFaqs = [
  {
    id: 'f1',
    pertanyaan: 'Berapa jumlah minimal pemesanan (MOQ) di seminarkit?',
    jawaban: 'Minimal order mulai dari 30 pcs untuk paket custom hardbox eksklusif dan mulai dari 50 pcs untuk souvenir satuan seperti tumbler atau totebag. Untuk kebutuhan di bawah MOQ standar, silakan konsultasikan dengan tim sales kami lewat WhatsApp.',
  },
  {
    id: 'f2',
    pertanyaan: 'Berapa lama estimasi waktu pengerjaan produksi?',
    jawaban: 'Waktu produksi standar berkisar antara 7 hingga 14 hari kerja setelah approval sampel fisik / mockup digital final. Untuk kebutuhan mendesak (urgent order), kami menyediakan layanan pengerjaan kilat tergantung ketersediaan stok material.',
  },
  {
    id: 'f3',
    pertanyaan: 'Apakah bisa mengirim sampel fisik sebelum produksi massal?',
    jawaban: 'Ya, kami dapat mengirimkan sampel material fisik (dummy produk) atau proofing digital dengan logo perusahaan Anda agar Anda dapat memastikan warna, tekstur, dan proporsinya sesuai standar sebelum produksi penuh.',
  },
  {
    id: 'f4',
    pertanyaan: 'Apakah isi paket seminar kit bisa dikustomisasi bebas?',
    jawaban: 'Tentu. Anda bebas mengombinasikan item apa pun, misalnya agenda + flashdisk saja, atau totebag + tumbler + pulpen + kartu tanda pengenal (lanyard), sesuai anggaran dan tema kegiatan Anda.',
  },
  {
    id: 'f5',
    pertanyaan: 'Bagaimana prosedur pembayaran dan faktur pajak resmi?',
    jawaban: 'Kami melayani pembayaran transfer bank resmi rekening giro perusahaan dan siap menerbitkan Faktur Pajak resmi (PPN) serta invoice resmi untuk keperluan pertanggungjawaban anggaran instansi Anda.',
  },
];
const displayFaqs = (faqs && faqs.length > 0) ? faqs : fallbackFaqs;

const waUrl = buildWaFromPage(settings?.wa_number, 'Beranda');

const schemas = [
  organizationSchema(),
  websiteSchema(),
  ...(displayFaqs.length ? [faqSchema(displayFaqs)] : []),
];
---

<BaseLayout
  title="Souvenir Kantor & Seminar Kit Berkualitas"
  description="seminarkit — produsen souvenir kantor dan paket seminar kit berkualitas untuk perusahaan dan instansi di seluruh Indonesia. Harga transparan, minimum order fleksibel, garansi tepat waktu."
  settings={settings}
  currentPage="Beranda"
  jsonLd={schemas}
>
  <!-- ========================================================
       1. HERO SECTION (Sporoforia Reference Style)
       ======================================================== -->
  <section class="sk-sporoforia-hero" aria-labelledby="hero-heading">
    <div class="container position-relative" style="z-index: 2;">
      <!-- Brand Monogram / Eyebrow -->
      <div class="sk-hero-brand-tag">
        <span class="sk-hero-monogram">SEMINARKIT</span>
      </div>

      <!-- Main Headline in Newsreader Serif -->
      <h1 id="hero-heading" class="sk-hero-headline">
        {hero.judul}
      </h1>

      <!-- Subtitle Description -->
      <p class="sk-hero-subtext">
        {hero.subjudul}
      </p>

      <!-- Action Buttons -->
      <div class="sk-hero-actions">
        <a href="/produk" class="sk-pill-btn sk-pill-btn--khaki">
          {hero.btnProduk || 'Lihat Katalog Produk'}
        </a>
        <a href={waUrl} class="sk-pill-btn sk-pill-btn--glass" target="_blank" rel="noopener noreferrer">
          <svg width="15" height="15" viewBox="0 0 448 512" fill="currentColor" aria-hidden="true">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"></path>
          </svg>
          <span>{hero.btnWa || 'Konsultasi WhatsApp'}</span>
        </a>
      </div>
    </div>

    <!-- Organic Wave Cutout Transition into Cream Background -->
    <div class="sk-hero-wave" aria-hidden="true">
      <svg viewBox="0 0 1440 90" fill="none" preserveAspectRatio="none">
        <path d="M0,0 C320,65 520,15 720,48 C920,80 1140,25 1440,60 L1440,94 L0,94 Z" fill="#FBFAF5"></path>
      </svg>
    </div>
  </section>

  <!-- ========================================================
       1.5 KEY PILLARS ICON STRIP (Reference Style: Our Key Pillars)
       ======================================================== -->
  <section class="sk-key-pillars-strip" aria-label="Pilar Komitmen seminarkit">
    <div class="container">
      <div class="text-center mb-4 pb-1">
        <p class="sk-pillars-tag">Pilar Komitmen Utama</p>
      </div>

      <div class="row row-cols-2 row-cols-sm-3 row-cols-md-5 g-4 justify-content-center text-center">
        <!-- Pillar 1: Integritas & Kualitas (Heart in Hands) -->
        <div class="col">
          <div class="sk-pillar-item">
            <div class="sk-pillar-icon-box">
              <svg width="46" height="46" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="24" y1="5" x2="24" y2="8"></line>
                <line x1="16" y1="8" x2="18" y2="10.5"></line>
                <line x1="32" y1="8" x2="30" y2="10.5"></line>
                <path d="M24 13.5 C21 10 16 10 14 13.5 C12 17 15 20.5 24 26 C33 20.5 36 17 34 13.5 C32 10 27 10 24 13.5 Z"></path>
                <path d="M8 32 C12 30 16 31 20 34 L24 37 L28 34 C32 31 36 30 40 32"></path>
                <path d="M12 36 L15 41 C17 43 21 44 24 44 C27 44 31 43 33 41 L36 36"></path>
              </svg>
            </div>
            <h4 class="sk-pillar-name">Integritas &amp; Kualitas</h4>
          </div>
        </div>

        <!-- Pillar 2: Ramah Lingkungan (Plant in Hands) -->
        <div class="col">
          <div class="sk-pillar-item">
            <div class="sk-pillar-icon-box">
              <svg width="46" height="46" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M24 36 V17"></path>
                <path d="M24 17 C24 11 19 8 15 9 C15 14 18 17 24 17 Z"></path>
                <path d="M24 13 C24 8 29 5 33 6 C33 11 30 14 24 14 Z"></path>
                <path d="M24 23 C24 19 28 17 31 18 C31 22 28 24 24 24 Z"></path>
                <path d="M10 32 C13 28 17 29 20 33 L22 36"></path>
                <path d="M38 32 C35 28 31 29 28 33 L26 36"></path>
                <path d="M13 37 L17 42 C19 44 22 44 24 44 C26 44 29 44 31 42 L35 37"></path>
              </svg>
            </div>
            <h4 class="sk-pillar-name">Bahan Berkelanjutan</h4>
          </div>
        </div>

        <!-- Pillar 3: Kemitraan Terpercaya (Globe in Hands) -->
        <div class="col">
          <div class="sk-pillar-item">
            <div class="sk-pillar-icon-box">
              <svg width="46" height="46" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="24" cy="18" r="10"></circle>
                <ellipse cx="24" cy="18" rx="4.5" ry="10"></ellipse>
                <line x1="14" y1="18" x2="34" y2="18"></line>
                <path d="M8 32 C12 29 17 30 21 34 L24 37 L27 34 C31 30 36 29 40 32"></path>
                <path d="M12 37 L15 41 C18 43 21 44 24 44 C27 44 30 43 33 41 L36 37"></path>
              </svg>
            </div>
            <h4 class="sk-pillar-name">Kemitraan Terpercaya</h4>
          </div>
        </div>

        <!-- Pillar 4: Kustomisasi Presisi (Diamond with Network Nodes) -->
        <div class="col">
          <div class="sk-pillar-item">
            <div class="sk-pillar-icon-box">
              <svg width="46" height="46" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <polygon points="24 10 33 20 24 35 15 20"></polygon>
                <line x1="15" y1="20" x2="33" y2="20"></line>
                <circle cx="9" cy="20" r="3"></circle>
                <circle cx="39" cy="20" r="3"></circle>
                <circle cx="16" cy="40" r="3"></circle>
                <circle cx="32" cy="40" r="3"></circle>
                <circle cx="24" cy="5" r="2.5"></circle>
                <line x1="12" y1="20" x2="15" y2="20"></line>
                <line x1="33" y1="20" x2="36" y2="20"></line>
                <line x1="18" y1="38" x2="21" y2="32"></line>
                <line x1="30" y1="38" x2="27" y2="32"></line>
                <line x1="24" y1="7.5" x2="24" y2="10"></line>
              </svg>
            </div>
            <h4 class="sk-pillar-name">Kustomisasi Presisi</h4>
          </div>
        </div>

        <!-- Pillar 5: Transparansi Harga (Fair Trade Scales) -->
        <div class="col">
          <div class="sk-pillar-item">
            <div class="sk-pillar-icon-box">
              <svg width="46" height="46" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="24" cy="11" r="3.5"></circle>
                <line x1="24" y1="5" x2="24" y2="7.5"></line>
                <line x1="20" y1="8" x2="21.5" y2="9.5"></line>
                <line x1="28" y1="8" x2="26.5" y2="9.5"></line>
                <line x1="24" y1="14.5" x2="24" y2="41"></line>
                <line x1="16" y1="41" x2="32" y2="41"></line>
                <line x1="11" y1="16" x2="37" y2="16"></line>
                <line x1="11" y1="16" x2="7" y2="26"></line>
                <line x1="11" y1="16" x2="15" y2="26"></line>
                <path d="M6 26 C6 30 16 30 16 26 Z"></path>
                <line x1="37" y1="16" x2="33" y2="26"></line>
                <line x1="37" y1="16" x2="41" y2="26"></line>
                <path d="M32 26 C32 30 42 30 42 26 Z"></path>
              </svg>
            </div>
            <h4 class="sk-pillar-name">Harga Transparan</h4>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================
       2. TENTANG SEMINARKIT (Reference Style: Adventure Showcase / Two-Column)
       ======================================================== -->
  <section class="sk-intro-section" aria-labelledby="intro-heading">
    <!-- Hidden SVG Defs for Torn Deckle Paper Clip Paths -->
    <svg width="0" height="0" style="position:absolute;width:0;height:0;overflow:hidden;" aria-hidden="true">
      <defs>
        <clipPath id="sk-torn-outer-clip" clipPathUnits="objectBoundingBox">
          <path d="M 0.0200 0.0268 L 0.0474 0.0270 L 0.0749 0.0365 L 0.1023 0.0341 L 0.1297 0.0245 L 0.1571 0.0287 L 0.1846 0.0213 L 0.2120 0.0246 L 0.2394 0.0266 L 0.2669 0.0185 L 0.2943 0.0150 L 0.3217 0.0284 L 0.3491 0.0288 L 0.3766 0.0239 L 0.4040 0.0243 L 0.4314 0.0310 L 0.4589 0.0339 L 0.4863 0.0308 L 0.5137 0.0171 L 0.5411 0.0224 L 0.5686 0.0265 L 0.5960 0.0110 L 0.6234 0.0210 L 0.6509 0.0125 L 0.6783 0.0195 L 0.7057 0.0188 L 0.7331 0.0237 L 0.7606 0.0359 L 0.7880 0.0313 L 0.8154 0.0208 L 0.8429 0.0208 L 0.8703 0.0298 L 0.8977 0.0207 L 0.9251 0.0248 L 0.9526 0.0159 L 0.9800 0.0196 L 0.9726 0.0300 L 0.9721 0.0636 L 0.9783 0.0971 L 0.9764 0.1307 L 0.9682 0.1643 L 0.9729 0.1979 L 0.9654 0.2314 L 0.9678 0.2650 L 0.9767 0.2986 L 0.9813 0.3321 L 0.9781 0.3657 L 0.9749 0.3993 L 0.9765 0.4329 L 0.9756 0.4664 L 0.9699 0.5000 L 0.9767 0.5336 L 0.9746 0.5671 L 0.9733 0.6007 L 0.9770 0.6343 L 0.9648 0.6679 L 0.9807 0.7014 L 0.9752 0.7350 L 0.9856 0.7686 L 0.9740 0.8021 L 0.9736 0.8357 L 0.9706 0.8693 L 0.9738 0.9029 L 0.9731 0.9364 L 0.9730 0.9700 L 0.9800 0.9822 L 0.9526 0.9706 L 0.9251 0.9844 L 0.8977 0.9888 L 0.8703 0.9755 L 0.8429 0.9804 L 0.8154 0.9675 L 0.7880 0.9708 L 0.7606 0.9749 L 0.7331 0.9627 L 0.7057 0.9807 L 0.6783 0.9761 L 0.6509 0.9857 L 0.6234 0.9793 L 0.5960 0.9823 L 0.5686 0.9766 L 0.5411 0.9784 L 0.5137 0.9701 L 0.4863 0.9746 L 0.4589 0.9654 L 0.4314 0.9686 L 0.4040 0.9780 L 0.3766 0.9785 L 0.3491 0.9872 L 0.3217 0.9875 L 0.2943 0.9797 L 0.2669 0.9803 L 0.2394 0.9730 L 0.2120 0.9661 L 0.1846 0.9740 L 0.1571 0.9657 L 0.1297 0.9747 L 0.1023 0.9791 L 0.0749 0.9677 L 0.0474 0.9778 L 0.0200 0.9863 L 0.0191 0.9700 L 0.0353 0.9364 L 0.0244 0.9029 L 0.0333 0.8693 L 0.0320 0.8357 L 0.0220 0.8021 L 0.0222 0.7686 L 0.0158 0.7350 L 0.0225 0.7014 L 0.0178 0.6679 L 0.0176 0.6343 L 0.0271 0.6007 L 0.0339 0.5671 L 0.0268 0.5336 L 0.0346 0.5000 L 0.0271 0.4664 L 0.0205 0.4329 L 0.0294 0.3993 L 0.0191 0.3657 L 0.0122 0.3321 L 0.0243 0.2986 L 0.0245 0.2650 L 0.0310 0.2314 L 0.0343 0.1979 L 0.0249 0.1643 L 0.0316 0.1307 L 0.0286 0.0971 L 0.0213 0.0636 L 0.0163 0.0300 Z" />
        </clipPath>
        <clipPath id="sk-torn-inner-clip" clipPathUnits="objectBoundingBox">
          <path d="M 0.0320 0.0388 L 0.0587 0.0390 L 0.0855 0.0485 L 0.1122 0.0461 L 0.1390 0.0365 L 0.1657 0.0407 L 0.1925 0.0333 L 0.2192 0.0366 L 0.2459 0.0386 L 0.2727 0.0305 L 0.2994 0.0270 L 0.3262 0.0404 L 0.3529 0.0408 L 0.3797 0.0359 L 0.4064 0.0363 L 0.4331 0.0430 L 0.4599 0.0459 L 0.4866 0.0428 L 0.5134 0.0291 L 0.5401 0.0344 L 0.5669 0.0385 L 0.5936 0.0230 L 0.6203 0.0330 L 0.6471 0.0245 L 0.6738 0.0315 L 0.7006 0.0308 L 0.7273 0.0357 L 0.7541 0.0479 L 0.7808 0.0433 L 0.8075 0.0328 L 0.8343 0.0328 L 0.8610 0.0418 L 0.8878 0.0327 L 0.9145 0.0368 L 0.9413 0.0279 L 0.9680 0.0316 L 0.9606 0.0420 L 0.9601 0.0747 L 0.9663 0.1074 L 0.9644 0.1401 L 0.9562 0.1729 L 0.9609 0.2056 L 0.9534 0.2383 L 0.9558 0.2710 L 0.9647 0.3037 L 0.9693 0.3364 L 0.9661 0.3691 L 0.9629 0.4019 L 0.9645 0.4346 L 0.9636 0.4673 L 0.9579 0.5000 L 0.9647 0.5327 L 0.9626 0.5654 L 0.9613 0.5981 L 0.9650 0.6309 L 0.9528 0.6636 L 0.9687 0.6963 L 0.9632 0.7290 L 0.9736 0.7617 L 0.9620 0.7944 L 0.9616 0.8271 L 0.9586 0.8599 L 0.9618 0.8926 L 0.9611 0.9253 L 0.9610 0.9580 L 0.9680 0.9702 L 0.9413 0.9586 L 0.9145 0.9724 L 0.8878 0.9768 L 0.8610 0.9635 L 0.8343 0.9684 L 0.8075 0.9555 L 0.7808 0.9588 L 0.7541 0.9629 L 0.7273 0.9507 L 0.7006 0.9687 L 0.6738 0.9641 L 0.6471 0.9737 L 0.6203 0.9673 L 0.5936 0.9703 L 0.5669 0.9646 L 0.5401 0.9664 L 0.5134 0.9581 L 0.4866 0.9626 L 0.4599 0.9534 L 0.4331 0.9566 L 0.4064 0.9660 L 0.3797 0.9665 L 0.3529 0.9752 L 0.3262 0.9755 L 0.2994 0.9677 L 0.2727 0.9683 L 0.2459 0.9610 L 0.2192 0.9541 L 0.1925 0.9620 L 0.1657 0.9537 L 0.1390 0.9627 L 0.1122 0.9671 L 0.0855 0.9557 L 0.0587 0.9658 L 0.0320 0.9743 L 0.0311 0.9580 L 0.0473 0.9253 L 0.0364 0.8926 L 0.0453 0.8599 L 0.0440 0.8271 L 0.0340 0.7944 L 0.0342 0.7617 L 0.0278 0.7290 L 0.0345 0.6963 L 0.0298 0.6636 L 0.0296 0.6309 L 0.0391 0.5981 L 0.0459 0.5654 L 0.0388 0.5327 L 0.0466 0.5000 L 0.0391 0.4673 L 0.0325 0.4346 L 0.0414 0.4019 L 0.0311 0.3691 L 0.0242 0.3364 L 0.0363 0.3037 L 0.0365 0.2710 L 0.0430 0.2383 L 0.0463 0.2056 L 0.0369 0.1729 L 0.0436 0.1401 L 0.0406 0.1074 L 0.0333 0.0747 L 0.0283 0.0420 Z" />
        </clipPath>
      </defs>
    </svg>

    <div class="container">
      <div class="row align-items-center g-4 g-lg-5 sk-intro-row">
        <!-- Photo Column: Tampil di atas pada mobile & di sebelah kiri pada desktop -->
        <div class="col-lg-6 order-1">
          <div class="sk-torn-media-box">
            <div class="sk-torn-frame-outer">
              <div class="sk-torn-frame-inner">
                <img
                  src="/images/about-seminarkit.webp"
                  alt="Proses Produksi dan Kualitas Seminar Kit seminarkit"
                  class="sk-torn-img"
                  loading="lazy"
                  decoding="async"
