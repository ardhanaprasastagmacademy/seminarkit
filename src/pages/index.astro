<script>
  function initTestimonialSlider() {
    const rotator = document.getElementById('sk-testimonial-rotator');
    if (!rotator) return;

    // Prevent duplicate initializations
    if ((rotator as any)._initialized) return;
    (rotator as any)._initialized = true;

    const slides = rotator.querySelectorAll<HTMLElement>('.sk-testimonial-slide');
    const dots = rotator.querySelectorAll<HTMLElement>('.sk-t-dot');
    const prevBtn = rotator.querySelector<HTMLButtonElement>('.sk-t-prev');
    const nextBtn = rotator.querySelector<HTMLButtonElement>('.sk-t-next');

    if (slides.length <= 1) return;

    let currentIndex = 0;
    let timer: number | undefined;
    const intervalTime = 5500; // 5.5s for comfortable reading

    function goToSlide(index: number) {
      if (index === currentIndex) return;

      slides[currentIndex]?.classList.remove('is-active');
      dots[currentIndex]?.classList.remove('is-active');
      dots[currentIndex]?.setAttribute('aria-selected', 'false');

      currentIndex = (index + slides.length) % slides.length;

      slides[currentIndex]?.classList.add('is-active');
      dots[currentIndex]?.classList.add('is-active');
      dots[currentIndex]?.setAttribute('aria-selected', 'true');
    }

    function nextSlide() {
      goToSlide(currentIndex + 1);
    }

    function prevSlide() {
      goToSlide(currentIndex - 1);
    }

    function startTimer() {
      stopTimer();
      timer = window.setInterval(nextSlide, intervalTime);
    }

    function stopTimer() {
      if (timer) {
        clearInterval(timer);
        timer = undefined;
      }
    }

    dots.forEach((dot) => {
      dot.addEventListener('click', () => {
        const targetIdx = parseInt(dot.dataset.slideIndex || '0', 10);
        goToSlide(targetIdx);
        startTimer();
      });
    });

    prevBtn?.addEventListener('click', () => {
      prevSlide();
      startTimer();
    });

    nextBtn?.addEventListener('click', () => {
      nextSlide();
      startTimer();
    });

    // Pause rotation while hovered or focused
    rotator.addEventListener('mouseenter', stopTimer);
    rotator.addEventListener('mouseleave', startTimer);
    rotator.addEventListener('touchstart', stopTimer, { passive: true });
    rotator.addEventListener('touchend', startTimer, { passive: true });

    startTimer();
  }

  function initHomeGalleryCarousel() {
    const track = document.getElementById('sk-home-gallery-track');
    const prevBtn = document.getElementById('sk-gal-prev-btn');
    const nextBtn = document.getElementById('sk-gal-next-btn');

    if (!track || !prevBtn || !nextBtn) return;
    if ((track as any)._carouselInitialized) return;
    (track as any)._carouselInitialized = true;

    function getScrollStep() {
      const card = track.querySelector('.sk-dark-photo-card') as HTMLElement | null;
      if (!card) return 320;
      return card.offsetWidth + 20;
    }

    prevBtn.addEventListener('click', () => {
      track.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
    });

    nextBtn.addEventListener('click', () => {
      track.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
    });
  }

  function initFaqAccordion() {
    const list = document.getElementById('faq-accordion-list');
    if (!list) return;
    if ((list as any)._initialized) return;
    (list as any)._initialized = true;

    const cards = list.querySelectorAll<HTMLElement>('.sk-faq-card');
    cards.forEach((card) => {
      const header = card.querySelector<HTMLButtonElement>('.sk-faq-card-header');
      const body = card.querySelector<HTMLElement>('.sk-faq-card-body');
      if (!header || !body) return;

      header.addEventListener('click', () => {
        const isOpen = card.classList.contains('is-open');

        cards.forEach((other) => {
          if (other !== card && other.classList.contains('is-open')) {
            other.classList.remove('is-open');
            other.querySelector('.sk-faq-card-header')?.setAttribute('aria-expanded', 'false');
            const otherBody = other.querySelector<HTMLElement>('.sk-faq-card-body');
            if (otherBody) otherBody.style.display = 'none';
          }
        });

        if (isOpen) {
          card.classList.remove('is-open');
          header.setAttribute('aria-expanded', 'false');
          body.style.display = 'none';
        } else {
          card.classList.add('is-open');
          header.setAttribute('aria-expanded', 'true');
          body.style.display = 'block';
        }
      });
    });
  }

  function initAllHomeScripts() {
    initTestimonialSlider();
    initHomeGalleryCarousel();
    initFaqAccordion();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllHomeScripts);
  } else {
    initAllHomeScripts();
  }
  document.addEventListener('astro:page-load', initAllHomeScripts);
</script>
